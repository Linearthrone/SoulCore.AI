{
  "Host": {
    "BindAddress": "127.0.0.1",
    "Port": 7700
  },
  "Memory": {
    "DbPath": ""
  },
  "Inference": {
    "Enabled": true,
    "BaseUrl": "http://127.0.0.1:11434",
    "Model": "gemma4:latest",
    "TimeoutSeconds": 120
  },
  "Hermes": {
    "Enabled": true,
    "BaseUrl": "http://127.0.0.1:8642",
    "Model": "local",
    "TimeoutSeconds": 120
  },
  "ChatWs": {
    "Path": "/ws",
    "PreferHermes": false,
    "StubWhenModelDown": false
  },
  "UnrealBridge": {
    "Enabled": true,
    "WsUrl": "ws://127.0.0.1:8888",
    "ConnectOnStartup": true,
    "ConnectTimeoutSeconds": 2
  },
  "SoulLoop": {
    "Enabled": false,
    "TickIntervalSeconds": 60,
    "EpisodicRecallLimit": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
