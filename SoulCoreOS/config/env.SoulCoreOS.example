# SoulCoreOS Host environment drop-in — EXAMPLE ONLY (TASK-20260729-002 / BED-01)
#
# Copy to the path referenced by soulcore-host.service EnvironmentFile, e.g.:
#   sudo install -m 600 -o root -g soulcore /dev/null /etc/soulcore/soulcore.env
#   sudoedit /etc/soulcore/soulcore.env
#
# Rules:
# - Never commit real secret values.
# - Host loads SOULCORE_* via AddEnvironmentVariables(prefix: "SOULCORE_").
#   Nesting uses double-underscore: Section__Property → SOULCORE_Section__Property.
# - Existing non-empty process env wins over .env files the Host may also load.
# - Lines starting with # are comments. Blank values mean "unset / use appsettings".

# =============================================================================
# Secrets (fill on the machine — leave empty in git copies)
# =============================================================================
# SOULCORE_A2E_TOKEN=
# SOULCORE_HERMES_API_KEY=
# SOULCORE_HF_TOKEN=
# Companion /ws fail-closed token (≥32 random chars) when exposing beyond loopback desktop.
# SOULCORE_COMPANION_API_TOKEN=

# =============================================================================
# Host bind (SEC-004 — keep loopback)
# =============================================================================
# SOULCORE_Host__BindAddress=127.0.0.1
# SOULCORE_Host__Port=7700

# =============================================================================
# UnrealBridge — Shadow body on house-victoria (defaults also in appsettings.SoulCoreOS.json)
# =============================================================================
# SOULCORE_UnrealBridge__Enabled=true
# SOULCORE_UnrealBridge__WsUrl=ws://house-victoria:8888
# SOULCORE_UnrealBridge__ConnectOnStartup=true
# SOULCORE_UnrealBridge__ConnectTimeoutSeconds=10

# =============================================================================
# Inference — local Ollama on KAIA
# =============================================================================
# SOULCORE_Inference__Enabled=true
# SOULCORE_Inference__BaseUrl=http://127.0.0.1:11434
# SOULCORE_Inference__Model=qwen2.5:14b
# SOULCORE_Inference__NumCtx=65536
# SOULCORE_Inference__TimeoutSeconds=180
# SOULCORE_Hermes__Enabled=false

# =============================================================================
# Memory / Chat / SoulLoop (optional overrides)
# =============================================================================
# SOULCORE_Memory__DbPath=/var/lib/soulcore/soulcore_memory.db
# SOULCORE_ChatWs__Path=/ws
# SOULCORE_ChatWs__StubWhenModelDown=false
# SOULCORE_SoulLoop__Enabled=false

# =============================================================================
# Ollama process env (NOT SOULCORE_*) — set on ollama.service / Containerfile
# Target: 16GB VRAM + 64k context
# =============================================================================
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
#
# These are consumed by the Ollama daemon, not SoulCore.Host. Documented here so
# OPS wires them next to the Host unit on the same SoulCoreOS image.
