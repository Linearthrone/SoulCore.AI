# Local-only placeholders — copy to SoulCore/.env (never commit real tokens).
# Host loads SOULCORE_* keys into process env before config bind; existing process env wins.

SOULCORE_A2E_TOKEN=
SOULCORE_HERMES_API_KEY=
SOULCORE_HF_TOKEN=
SOULCORE_OLLAMA_API_KEY=

# Companion /ws upgrade token (BED-155). When set, Host fail-closes /ws without
# Authorization: Bearer <token> or X-Api-Key: <token>. Leave empty for local
# loopback desktop (no header required). Prefer ≥ 32 random chars when enabling
# Tailscale serve for phone. Never commit real values.
# SOULCORE_COMPANION_API_TOKEN=

# PROP-1.2 SMS/MMS gateway (tablet SM-X218U). Never commit real MDNs.
# SOULCORE_Sms__KurtAllowlistE164=+1XXXXXXXXXX
# SOULCORE_Sms__VictoriaMdn=+1YYYYYYYYYY
# SOULCORE_Sms__StubWhenModelDown=false
# SOULCORE_Sms__ConversationSessionId=presence-local
# Inbound: POST /api/companion/v1/messages/inbound — see docs/runbooks/sms-gateway-inbound.md

# Optional overrides (non-secret)
# SOULCORE_Memory__DbPath=
# SOULCORE_Inference__Enabled=true
# SOULCORE_Inference__BaseUrl=http://127.0.0.1:11434
# SOULCORE_Inference__Model=gemma4:latest

# --- BED-187: Ollama Cloud for chat/tools (frees local VRAM) ---
# 1) Create a key at https://ollama.com/settings/keys
# 2) Recommended tools-capable cloud model: deepseek-v4-flash
# SOULCORE_OLLAMA_API_KEY=
# SOULCORE_Inference__BaseUrl=https://ollama.com
# SOULCORE_Inference__Model=deepseek-v4-flash:cloud
# SOULCORE_Inference__TimeoutSeconds=180
# SOULCORE_Inference__ThinkEnabled=false
# Leave EmbeddingBaseUrl empty (default) → embeddings stay on local :11434
# SOULCORE_Inference__EmbeddingBaseUrl=http://127.0.0.1:11434
# SOULCORE_Inference__EmbeddingsEnabled=true
#
# Alt (no Host BaseUrl change): `ollama signin` then:
# SOULCORE_Inference__Model=deepseek-v4-flash:cloud
# while BaseUrl stays http://127.0.0.1:11434 — local Ollama proxies to cloud.

# BED-195 / OPS-198: Victoria Playwright browser (not Kurt's Chrome).
# SOULCORE_Tools__BrowserBackend=playwright
# SOULCORE_Tools__PlaywrightUserDataDir=   # default %LOCALAPPDATA%\SoulCore\victoria-browser
# SOULCORE_Tools__PlaywrightHeaded=false
# Install browsers once: pwsh SoulCore/scripts/install-playwright.ps1
# Presence pane: GET http://127.0.0.1:7700/browser/view
# Hermes retired (BED-185) — leave disabled; Host forces Hermes off.
# BED-188: hard-scope desktop tools to Victoria's VirtualBox Ubuntu guest.
# SOULCORE_Tools__DesktopTargetWindowTitle=victoria-sandbox
# Clear to allow full Windows desktop: SOULCORE_Tools__DesktopTargetWindowTitle=
# Guest Additions guestcontrol (apps/clicks inside Ubuntu; VirtualBox window can stay minimized):
# SOULCORE_VBOX_GUEST_USER=victoria
# SOULCORE_VBOX_GUEST_PASS=
# Never commit the real password. Restart Host after setting.
# Password = Ubuntu login for that guest user (not Windows, not VirtualBox encryption).
# Verify Host sees it:  dotnet run --project SoulCore/SoulCore.Host -c Release -- --secrets-presence
# Verify guestcontrol:  dotnet run --project SoulCore/SoulCore.Host -c Release -- --guestcontrol-probe
# Manual VBoxManage (do NOT repeat the exe after -- — that breaks `id`):
#   VBoxManage guestcontrol victoria-sandbox run --username victoria --password <pass> --exe /usr/bin/whoami --wait-stdout --wait-stderr --
# Wrong:  ... --exe /usr/bin/id -- /usr/bin/id -un   → "no such user" even when logon works
# Right:  ... --exe /usr/bin/id -- -un
# Or:     ... --exe /usr/bin/whoami --
# MT4 default (BED-169): Tools:Mt4Backend=llmod → http://house-victoria:8080 (MagicDNS hyphen).
# Override if needed: SOULCORE_Tools__LlmodMcpEndpoint=http://100.107.94.17:8080
# Shadow MCP must bind 0.0.0.0:8080 (not localhost-only); see TASK-170 OPS report.

# Email (IMAP/SMTP). Never commit real addresses or app passwords.
# Create Victoria's mailbox + app passwords, then fill these and restart Host.
# Enable gates in ChatDesktop Settings → Tools & Access (or SOULCORE_Tools__AllowEmailRead=true).
# See docs/runbooks/victoria-email.md
# SOULCORE_Tools__AllowEmailRead=false
# SOULCORE_Tools__AllowEmailSend=false
# SOULCORE_Tools__AllowEmailDelete=false
# SOULCORE_Email__Accounts__0__Id=victoria
# SOULCORE_Email__Accounts__0__Role=victoria
# SOULCORE_Email__Accounts__0__DisplayName=Victoria
# SOULCORE_Email__Accounts__0__Address=victoria@example.com
# SOULCORE_Email__Accounts__0__Username=victoria@example.com
# SOULCORE_Email__Accounts__0__Password=
# SOULCORE_Email__Accounts__1__Id=personal
# SOULCORE_Email__Accounts__1__Role=personal
# SOULCORE_Email__Accounts__1__DisplayName=Kurt personal
# SOULCORE_Email__Accounts__1__Address=
# SOULCORE_Email__Accounts__1__Username=
# SOULCORE_Email__Accounts__1__Password=
# SOULCORE_Email__Accounts__2__Id=business
# SOULCORE_Email__Accounts__2__Role=business
# SOULCORE_Email__Accounts__2__DisplayName=Kurt business
# SOULCORE_Email__Accounts__2__Address=
# SOULCORE_Email__Accounts__2__Username=
# SOULCORE_Email__Accounts__2__Password=
