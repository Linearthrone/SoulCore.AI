# Local-only placeholders — copy to SoulCore/.env (never commit real tokens).
# Host loads SOULCORE_* keys into process env before config bind; existing process env wins.

SOULCORE_A2E_TOKEN=
SOULCORE_HERMES_API_KEY=
SOULCORE_HF_TOKEN=
SOULCORE_OLLAMA_API_KEY=

# Companion /ws upgrade token (BED-155). When set, Host fail-closes /ws without
# Authorization: Bearer <token> or X-Api-Key: <token>. Leave empty for local
# loopback desktop (no header required). Prefer ≥ 32 random chars when enabling
# Tailscale serve for phone. Never commit real values.
# SOULCORE_COMPANION_API_TOKEN=

# Optional overrides (non-secret)
# SOULCORE_Memory__DbPath=
# SOULCORE_Inference__Enabled=true
# SOULCORE_Inference__BaseUrl=http://127.0.0.1:11434
# SOULCORE_Inference__Model=gemma4:latest

# --- BED-187: Ollama Cloud for chat/tools (frees local VRAM) ---
# 1) Create a key at https://ollama.com/settings/keys
# 2) Recommended tools-capable cloud model: deepseek-v4-flash
# SOULCORE_OLLAMA_API_KEY=
# SOULCORE_Inference__BaseUrl=https://ollama.com
# SOULCORE_Inference__Model=deepseek-v4-flash:cloud
# SOULCORE_Inference__TimeoutSeconds=180
# SOULCORE_Inference__ThinkEnabled=false
# Leave EmbeddingBaseUrl empty (default) → embeddings stay on local :11434
# SOULCORE_Inference__EmbeddingBaseUrl=http://127.0.0.1:11434
# SOULCORE_Inference__EmbeddingsEnabled=true
#
# Alt (no Host BaseUrl change): `ollama signin` then:
# SOULCORE_Inference__Model=deepseek-v4-flash:cloud
# while BaseUrl stays http://127.0.0.1:11434 — local Ollama proxies to cloud.

# Hermes retired (BED-185) — leave disabled; Host forces Hermes off.
# BED-188: hard-scope desktop tools to Victoria's VirtualBox Ubuntu guest.
# SOULCORE_Tools__DesktopTargetWindowTitle=victoria-sandbox
# Clear to allow full Windows desktop: SOULCORE_Tools__DesktopTargetWindowTitle=
# Guest Additions guestcontrol (apps/clicks inside Ubuntu; VirtualBox window can stay minimized):
# SOULCORE_VBOX_GUEST_USER=victoria
# SOULCORE_VBOX_GUEST_PASS=
# Never commit the real password. Restart Host after setting.
# MT4 default (BED-169): Tools:Mt4Backend=llmod → http://house-victoria:8080 (MagicDNS hyphen).
# Override if needed: SOULCORE_Tools__LlmodMcpEndpoint=http://100.107.94.17:8080
# Shadow MCP must bind 0.0.0.0:8080 (not localhost-only); see TASK-170 OPS report.
