<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SoulCore.Core\SoulCore.Core.csproj" />
    <ProjectReference Include="..\SoulCore.Memory\SoulCore.Memory.csproj" />
    <ProjectReference Include="..\SoulCore.Inference\SoulCore.Inference.csproj" />
    <ProjectReference Include="..\SoulCore.Adapters.Ws\SoulCore.Adapters.Ws.csproj" />
    <ProjectReference Include="..\SoulCore.Config\SoulCore.Config.csproj" />
    <ProjectReference Include="..\SoulCore.Protocol\SoulCore.Protocol.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>soulcore-host-phase0-dev</UserSecretsId>
    <!-- Bump with House/scripts/bump-versions.ps1 (-Target host) on every Host fix. -->
    <Version>0.1.10</Version>
    <InformationalVersion>0.1.10</InformationalVersion>
    <Product>SoulCore Host</Product>
    <Company>LinearThrone</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Windows.Extensions" Version="8.0.0" />
  </ItemGroup>

  <!-- Always copy so a stale bin/Debug copy cannot keep DesktopBackend=native. -->
  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
