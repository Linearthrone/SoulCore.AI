    "wall.draw_perimeter_rect": {
      "id": "wall.draw_perimeter_rect",
      "summary": "Click-drag four exterior walls approximating footprint (width_ft x depth_ft)",
      "menu": null,
      "hotkey_hint": null,
      "ui": { "find": "plan_canvas", "verify_cursor": "wall_draw" },
      "gesture": {
        "type": "click_drag_sequence",
        "segments": "rectangle",
        "from": "plan_origin_approx",
        "note": "Use desktop_drag for each side. Sketch approximate lengths; do not require pixel-perfect feet."
      },
      "desktop_tools": ["desktop_drag", "desktop_screenshot"],
      "params": ["width_ft", "depth_ft", "origin_screen_xy"],
      "verify": ["four_exterior_walls_visible", "status_bar_length_visible"]
    },
