{
  "recipes": {
    "session.focus": {
      "id": "session.focus",
      "summary": "Focus the Chief Architect window",
      "menu": null,
      "hotkey_hint": null,
      "ui": { "find": "window_title", "match": "Chief Architect" },
      "gesture": { "type": "focus_window", "title_contains": "Chief Architect" },
      "desktop_tools": ["list_desktop_windows", "focus_desktop_window"],
      "params": [],
      "verify": ["chief_architect_foreground"]
    },
    "session.new_plan": {
      "id": "session.new_plan",
      "summary": "Start a new plan from the default template (File > New Plan)",
      "menu": ["File", "New Plan"],
      "hotkey_hint": "Ctrl+N",
      "ui": { "find": "menu_or_hotkey", "verify_cursor": null },
      "gesture": { "type": "hotkey_or_menu", "prefer": "hotkey" },
      "desktop_tools": ["desktop_key", "desktop_click"],
      "params": [],
      "verify": ["plan_view_empty_or_new"]
    },
    "session.plan_view": {
      "id": "session.plan_view",
      "summary": "Confirm Floor Plan view is active (not 3D/camera)",
      "menu": ["Tools", "Active View", "Floor Plan"],
      "hotkey_hint": null,
      "ui": { "find": "menu_or_toolbar", "verify_cursor": "plan" },
      "gesture": { "type": "menu" },
      "desktop_tools": ["desktop_click", "desktop_screenshot"],
      "params": [],
      "verify": ["plan_view_visible"]
    },
    "session.grid_snaps_on": {
      "id": "session.grid_snaps_on",
      "summary": "Enable Grid Snaps for shell walls",
      "menu": ["Edit", "Snap Settings", "Grid Snaps"],
      "hotkey_hint": null,
      "ui": { "find": "menu", "toggle": "on" },
      "gesture": { "type": "menu" },
      "desktop_tools": ["desktop_click"],
      "params": [],
      "verify": ["grid_snaps_enabled"]
