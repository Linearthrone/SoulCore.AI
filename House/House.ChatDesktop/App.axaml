<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="House.ChatDesktop.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- PROP-4 mockup: charcoal / brushed metal + neon lamps (not purple glass) -->
    <SolidColorBrush x:Key="BgBrush" Color="#0B0C0E"/>
    <SolidColorBrush x:Key="ShellBrush" Color="#121316"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#17191C"/>
    <SolidColorBrush x:Key="PanelBrushSoft" Color="#1C1E22"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2E36"/>
    <SolidColorBrush x:Key="MetalHighlightBrush" Color="#3A404C"/>
    <SolidColorBrush x:Key="CarbonBrush" Color="#0E0F12"/>
    <SolidColorBrush x:Key="CarbonEdgeBrush" Color="#23262D"/>
    <SolidColorBrush x:Key="ScrewBrush" Color="#5A5E68"/>
    <SolidColorBrush x:Key="ScrewSlotBrush" Color="#0A0A0C"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6E7EA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B8E97"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4BA3FF"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#2A5F99"/>
    <SolidColorBrush x:Key="OkBrush" Color="#3DFF8A"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FFB84D"/>
    <SolidColorBrush x:Key="BadBrush" Color="#FF3D4A"/>
    <SolidColorBrush x:Key="LampBlueBrush" Color="#3D8BFF"/>
    <SolidColorBrush x:Key="LampGreenBrush" Color="#2EE66A"/>
    <SolidColorBrush x:Key="LampRedBrush" Color="#FF3D4A"/>
    <SolidColorBrush x:Key="LampOffBrush" Color="#3A3D46"/>
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#2A2D33"/>
    <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#22252A"/>
    <SolidColorBrush x:Key="InputBrush" Color="#14161A"/>
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#1A1C20"/>
    <SolidColorBrush x:Key="GaugeFillBrush" Color="#3D8BFF"/>
    <SolidColorBrush x:Key="ShellGlowBrush" Color="#334BA3FF"/>
    <!-- Mockup metal: dark → bright refraction → dark (bevel / light strike) -->
    <LinearGradientBrush x:Key="MetalBevelBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#060708" Offset="0"/>
      <GradientStop Color="#1E2228" Offset="0.22"/>
      <GradientStop Color="#9AA3B0" Offset="0.44"/>
      <GradientStop Color="#FFFFFF" Offset="0.50"/>
      <GradientStop Color="#8A93A2" Offset="0.56"/>
      <GradientStop Color="#16191F" Offset="0.78"/>
      <GradientStop Color="#060708" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetalBevelHorizBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#050607" Offset="0"/>
      <GradientStop Color="#7A8494" Offset="0.40"/>
      <GradientStop Color="#FFFFFF" Offset="0.50"/>
      <GradientStop Color="#5A6474" Offset="0.60"/>
      <GradientStop Color="#0A0B0E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellFaceBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#22252B" Offset="0"/>
      <GradientStop Color="#14161A" Offset="0.28"/>
      <GradientStop Color="#0E0F12" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="DisplayFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <ImageBrush x:Key="BrushedTextureBrush"
                Source="avares://House.ChatDesktop/Assets/brushed-charcoal.png"
                Stretch="UniformToFill"
                TileMode="Tile"
                DestinationRect="0,0,64,256"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    </Style>

    <Style Selector="Border.shell-bevel">
      <Setter Property="Background" Value="{DynamicResource MetalBevelBrush}"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="BoxShadow" Value="0 0 0 1 #554BA3FF, 0 24 60 0 #EE000000, inset 0 1 0 0 #AAFFFFFF, inset 0 -1 0 0 #88000000"/>
    </Style>

    <Style Selector="Border.shell">
      <Setter Property="Background" Value="{DynamicResource ShellFaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MetalBevelHorizBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="BoxShadow" Value="inset 0 1 0 0 #77FFFFFF, inset 0 -1 0 0 #CC000000, inset 1 0 0 0 #33FFFFFF, inset -1 0 0 0 #66000000"/>
    </Style>

    <Style Selector="Border.shell-inner">
      <Setter Property="Background" Value="{DynamicResource BrushedTextureBrush}"/>
      <Setter Property="Opacity" Value="0.55"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style Selector="Border.shell-rim">
      <Setter Property="BorderBrush" Value="#CCD8DEE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="BoxShadow" Value="inset 0 1 0 0 #BBFFFFFF, inset 0 -1 0 0 #88000000"/>
    </Style>

    <Style Selector="Button.frame-nav">
      <Setter Property="Background" Value="#1A1C20"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  BoxShadow="inset 0 1 0 0 #22FFFFFF">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.frame-nav:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
    </Style>
    <Style Selector="Button.frame-nav.active">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="#1E2430"/>
    </Style>

    <Style Selector="Button.window-chrome">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.window-chrome:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>
    <Style Selector="Button.window-chrome.close:pointerover">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#C03D4A"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="#0B0C0E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  BoxShadow="0 0 12 0 #554BA3FF">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
    </Style>
    <Style Selector="Button.ghost:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="#16181C"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="5"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="TabControl.settings-tabs">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="TabBd"
                  Background="#1A1C20"
                  BorderBrush="{DynamicResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}"
                  BoxShadow="inset 0 1 0 0 #22FFFFFF">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#TabBd">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TabItem:selected /template/ Border#TabBd">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="#1E2430"/>
    </Style>

    <!-- Message row with contact bubbles outside the text bubble -->
    <Style Selector="Grid.msg-row">
      <Setter Property="Margin" Value="4,6"/>
    </Style>

    <Style Selector="Border.contact-bubble">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="Background" Value="#1A1C20"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,2,8,0"/>
      <Setter Property="BoxShadow" Value="0 0 8 0 #33000000"/>
    </Style>
    <Style Selector="Border.contact-bubble.user">
      <Setter Property="Margin" Value="8,2,0,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
    </Style>
    <Style Selector="Border.contact-bubble.assistant">
      <Setter Property="BorderBrush" Value="#3355AA88"/>
    </Style>

    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource AssistantBubbleBrush}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="MaxWidth" Value="520"/>
      <Setter Property="BorderBrush" Value="#2C3038"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 4 12 0 #44000000, inset 0 1 0 0 #18FFFFFF"/>
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="BorderBrush" Value="#343842"/>
    </Style>
    <Style Selector="Border.bubble.system">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="4,6"/>
      <Setter Property="Opacity" Value="0.8"/>
      <Setter Property="MaxWidth" Value="10000"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="BoxShadow" Value="none"/>
      <Setter Property="Margin" Value="8,2"/>
    </Style>

    <Style Selector="TextBox.input">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="ProgressBar.gauge">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource GaugeFillBrush}"/>
      <Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/>
    </Style>

    <Style Selector="Border.metal">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MetalBevelBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="Border.glass">
      <Setter Property="BoxShadow" Value="0 10 28 0 #66000000, inset 0 1 0 0 #44FFFFFF, inset 0 -1 0 0 #44000000, inset 1 0 0 0 #22FFFFFF"/>
    </Style>

    <Style Selector="Border.inset">
      <Setter Property="Background" Value="#0C0D10"/>
      <Setter Property="BoxShadow" Value="inset 0 3 10 0 #AA000000"/>
    </Style>

    <Style Selector="Border.mood-gem-well">
      <Setter Property="Background" Value="#0C0D10"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="inset 0 2 4 0 #88000000"/>
    </Style>

    <Style Selector="Border.carbon">
      <Setter Property="Background" Value="{DynamicResource CarbonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Button.house-tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.house-tab:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="#18FFFFFF"/>
    </Style>

    <Style Selector="Border.house-drawer-body">
      <Setter Property="Background" Value="#14161A"/>
      <Setter Property="BorderBrush" Value="{DynamicResource MetalHighlightBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="BoxShadow" Value="inset 0 1 0 0 #33FFFFFF"/>
    </Style>

    <Style Selector="Border.lamp-well">
      <Setter Property="Width" Value="56"/>
      <Setter Property="Height" Value="56"/>
      <Setter Property="CornerRadius" Value="28"/>
      <Setter Property="Background" Value="#07080A"/>
      <Setter Property="BorderBrush" Value="#3A404C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="BoxShadow" Value="inset 0 5 14 0 #EE000000, inset 0 -1 0 0 #33FFFFFF"/>
    </Style>

    <Style Selector="Button.lamp">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource LampOffBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="14"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  BoxShadow="inset 0 2 3 0 #88FFFFFF, inset 0 -2 4 0 #44000000"/>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="Ellipse.screw">
      <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="ToggleButton.chrome">
      <Setter Property="Background" Value="#16181C"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Styles>
</Application>
