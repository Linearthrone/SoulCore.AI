<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="House.ChatDesktop.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#1A1F24"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#242B33"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A4550"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA7B5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C4A574"/>
    <SolidColorBrush x:Key="OkBrush" Color="#6FBF8A"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D4A35C"/>
    <SolidColorBrush x:Key="BadBrush" Color="#D47676"/>
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#2F3A45"/>
    <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#2A323C"/>
    <SolidColorBrush x:Key="InputBrush" Color="#161A1F"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Nav "tabs" (RadioButton styled as underline tab) -->
    <Style Selector="RadioButton.nav">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Bd">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Primary (accent) button -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="#1A1F24"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- Ghost (outline) button -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Button.ghost:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- Settings tabs -->
    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="TabBd"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2"
                  Padding="{TemplateBinding Padding}"
                  Margin="0,0,8,0">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TabItem:selected /template/ Border#TabBd">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Transcript chat bubbles -->
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource AssistantBubbleBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="6"/>
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
    </Style>
    <Style Selector="Border.bubble.system">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="4,6"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- Dark input fields -->
    <Style Selector="TextBox.input">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    </Style>
  </Application.Styles>
</Application>
