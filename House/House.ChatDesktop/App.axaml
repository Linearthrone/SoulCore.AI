<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="House.ChatDesktop.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!-- Frosted blueish-purple metal — muted, not neon -->
    <SolidColorBrush x:Key="BgBrush" Color="#1B1830"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#3A3558"/>
    <SolidColorBrush x:Key="PanelBrushSoft" Color="#2C2848"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#6A6290"/>
    <SolidColorBrush x:Key="MetalHighlightBrush" Color="#7A74A0"/>
    <SolidColorBrush x:Key="CarbonBrush" Color="#12101C"/>
    <SolidColorBrush x:Key="CarbonEdgeBrush" Color="#2A2638"/>
    <SolidColorBrush x:Key="ScrewBrush" Color="#8A8498"/>
    <SolidColorBrush x:Key="ScrewSlotBrush" Color="#1A1724"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E4E0F0"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9A94B0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#A89BC8"/>
    <SolidColorBrush x:Key="OkBrush" Color="#6FA88A"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#C4A06A"/>
    <SolidColorBrush x:Key="BadBrush" Color="#C47A7A"/>
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#4A3F78"/>
    <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#2E2A48"/>
    <SolidColorBrush x:Key="InputBrush" Color="#1E1A30"/>
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#221E38"/>
    <SolidColorBrush x:Key="GaugeFillBrush" Color="#6E6498"/>
    <FontFamily x:Key="DisplayFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
    </Style>

    <Style Selector="RadioButton.nav">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="RadioButton.nav:checked">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Bd">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="#1B1830"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="5"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Button.ghost:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="{DynamicResource CarbonBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.chrome:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="TabBd"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2"
                  Padding="{TemplateBinding Padding}"
                  Margin="0,0,8,0">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TabItem:selected /template/ Border#TabBd">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource AssistantBubbleBrush}"/>
      <Setter Property="CornerRadius" Value="14,14,14,4"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="4,3,48,3"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="MaxWidth" Value="520"/>
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
      <Setter Property="CornerRadius" Value="14,14,4,14"/>
      <Setter Property="Margin" Value="48,3,4,3"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style Selector="Border.bubble.system">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="4,6"/>
      <Setter Property="Opacity" Value="0.8"/>
      <Setter Property="MaxWidth" Value="10000"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="8,2"/>
    </Style>

    <Style Selector="TextBox.input">
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
    </Style>

    <Style Selector="ProgressBar.gauge">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource GaugeFillBrush}"/>
      <Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/>
    </Style>

    <Style Selector="Border.metal">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <!-- PROP-4: depth without decorative screws -->
    <Style Selector="Border.glass">
      <Setter Property="BoxShadow" Value="0 8 24 0 #40000000, inset 0 1 0 0 #33FFFFFF"/>
    </Style>

    <Style Selector="Border.inset">
      <Setter Property="BoxShadow" Value="inset 0 2 6 0 #66000000"/>
    </Style>

    <Style Selector="Border.mood-gem-well">
      <Setter Property="Background" Value="#1A1628"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="inset 0 2 4 0 #88000000"/>
    </Style>

    <Style Selector="Border.carbon">
      <Setter Property="Background" Value="{DynamicResource CarbonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="Button.house-tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.house-tab:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>

    <Style Selector="Border.house-drawer-body">
      <Setter Property="Background" Value="#221E38"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style Selector="Border.lamp-well">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Background" Value="#14101F"/>
      <Setter Property="BorderBrush" Value="#2E2A40"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="BoxShadow" Value="inset 0 3 8 0 #AA000000"/>
    </Style>

    <Style Selector="Button.lamp">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="14"
                  Width="28" Height="28"
                  BoxShadow="0 0 10 1 #66000000">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.lamp.ok">
      <Setter Property="Background" Value="{DynamicResource OkBrush}"/>
    </Style>
    <Style Selector="Button.lamp.warn">
      <Setter Property="Background" Value="{DynamicResource WarnBrush}"/>
    </Style>
    <Style Selector="Button.lamp.bad">
      <Setter Property="Background" Value="{DynamicResource BadBrush}"/>
    </Style>
    <Style Selector="Button.lamp.accent">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="Ellipse.screw">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Height" Value="9"/>
      <Setter Property="Fill" Value="{DynamicResource ScrewBrush}"/>
      <Setter Property="Stroke" Value="{DynamicResource ScrewSlotBrush}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="ToggleButton.chrome">
      <Setter Property="Background" Value="{DynamicResource CarbonBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CarbonEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Styles>
</Application>
