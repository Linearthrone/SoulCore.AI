<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="House.ChatDesktop.ResearchJournalsWindow"
        Title="Research journals — House Victoria"
        Width="960" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}">
  <Border Classes="metal glass" Margin="12" Padding="14">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="280,12,*">
      <StackPanel Grid.ColumnSpan="3" Spacing="4" Margin="0,0,0,10">
        <DockPanel LastChildFill="False">
          <TextBlock Text="Research journals" FontSize="18" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Classes="chrome" Content="Refresh" FontSize="11"
                  Padding="10,4" Click="Refresh_Click"/>
        </DockPanel>
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                   Text="Broad subjects she researches between talks. Papers are APA drafts (review / experiment / theory) with bibliography."/>
        <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                   Text="Loading…"/>
      </StackPanel>

      <Border Grid.Row="1" Classes="carbon" Padding="8">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="Subjects" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <ListBox x:Name="SubjectList" SelectionChanged="SubjectList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2" Margin="0,4">
                  <TextBlock Text="{Binding Line}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Summary}" FontSize="11"
                             Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*,Auto,*">
        <TextBlock x:Name="PapersHeader" Text="Papers" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ListBox x:Name="PaperList" Grid.Row="1" SelectionChanged="PaperList_SelectionChanged"
                 MaxHeight="180">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Line}" TextWrapping="Wrap" Margin="0,3"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="Manuscript" FontWeight="SemiBold" Margin="0,10,0,6"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <TextBox x:Name="PaperBody" Classes="input" AcceptsReturn="True" TextWrapping="Wrap"
                   IsReadOnly="True" MinHeight="220"
                   Watermark="Select a paper to read the APA draft and references."/>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
</Window>
