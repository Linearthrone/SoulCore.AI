<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="House.ChatDesktop.MainWindow"
        Title="House Victoria — Presence"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        TransparencyLevelHint="Transparent,AcrylicBlur,Blur,None"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/house-victoria.ico">
  <!-- Frameless shell — thick metal bevel (dark→bright→dark refraction) -->
  <Border Classes="shell-bevel" Margin="6">
  <Border Classes="shell">
    <Grid>
      <Border Classes="shell-inner"/>
      <Border Classes="shell-rim" Margin="1"/>
      <DockPanel Margin="0">
        <!-- Title / identity frame strip (drag region) -->
        <Border x:Name="TitleDragRegion" DockPanel.Dock="Top" Padding="16,12,12,8"
                Background="Transparent" PointerPressed="TitleDragRegion_PointerPressed">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="8" Background="#1A1C20"
                      BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <TextBlock Text="HV" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="IdentityNameText" Text="Victoria" FontWeight="SemiBold" FontSize="16"/>
                  <Ellipse x:Name="MoodColorDot" Width="8" Height="8" Fill="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>
                  <TextBlock x:Name="MoodLabelText" Text="—" FontSize="12" FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{DynamicResource BadBrush}"
                           VerticalAlignment="Center"/>
                  <TextBlock x:Name="PresenceStateText" Text="—" FontSize="11"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="·" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="ActivityText" Text="—" FontSize="11" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" MaxWidth="380"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
              <!-- brand center-ish -->
              <StackPanel Margin="24,0,0,0" VerticalAlignment="Center" Opacity="0.85">
                <TextBlock Text="HOUSE VICTORIA" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}" LetterSpacing="1.5"/>
                <TextBlock x:Name="EndpointText" Text="127.0.0.1:7700" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" Opacity="0.6"/>
              </StackPanel>
            </StackPanel>

            <!-- Settings sits ON the frame (Presence tab removed) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
              <Button x:Name="NavSettings" Classes="frame-nav" Content="SETTINGS"
                      Click="NavSettings_Click"/>
              <Button Classes="chrome" Content="Correct mood…" FontSize="11" Padding="10,6"
                      Click="CorrectEmotion_Click"/>
              <Button Classes="chrome" Content="Refresh" Click="Refresh_Click"/>
              <TextBlock x:Name="ConnStatusText" Text="" IsVisible="False"/>
              <!-- Keep hidden for code-behind until fully purged -->
              <RadioButton x:Name="NavPresence" IsVisible="False" IsChecked="True"/>
              <Border Classes="mood-gem-well" Width="1" Height="1" IsVisible="False"/>
              <ToggleButton x:Name="HudAlwaysOnTop" IsVisible="False"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="window-chrome" Content="─" Click="Minimize_Click"/>
              <Button Classes="window-chrome close" Content="✕" Click="Close_Click"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Correct-mood panel (shared, overlays under strip) -->
        <Border x:Name="HudPanel" DockPanel.Dock="Top" IsVisible="False" Margin="12,0,12,0"/>
        <Border x:Name="EmotionCorrectPanel" DockPanel.Dock="Top" IsVisible="False" Classes="carbon glass"
                Padding="12" Margin="12,0,12,8">
          <StackPanel>
            <TextBlock Text="Correct mood" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid ColumnDefinitions="90,*,48" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,8">
              <TextBlock Text="valence" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectValenceSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" Margin="0,4"/>
              <TextBlock Grid.Column="2" Text="{Binding #CorrectValenceSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="1" Text="arousal" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectArousalSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Margin="0,4"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding #CorrectArousalSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="2" Text="dominance" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectDominanceSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Margin="0,4"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding #CorrectDominanceSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="3" Text="focus" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectFocusSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Margin="0,4"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding #CorrectFocusSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="False">
              <ProgressBar x:Name="ValenceGauge" Classes="gauge" Value="0.5" Width="80"/>
              <TextBlock x:Name="ValenceText" Text="0.0"/>
              <ProgressBar x:Name="ArousalGauge" Classes="gauge" Value="0" Width="80"/>
              <TextBlock x:Name="ArousalText" Text="0.0"/>
            </StackPanel>
            <TextBox x:Name="CorrectNoteBox" Classes="input" MaxLength="200" Height="34"
                     VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10" Watermark="short note"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Classes="ghost" Content="Cancel" Click="CorrectEmotionCancel_Click"/>
              <Button Classes="primary" Content="Save" Click="CorrectEmotionSave_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

    <Grid x:Name="PresenceView" Margin="12,4,12,0" RowDefinitions="*,Auto,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,260" ColumnSpacing="10">
        <Border x:Name="ChatPanel" Classes="metal glass" Padding="8">
          <Grid RowDefinitions="Auto,*">
            <DockPanel Margin="4,2,4,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="ChatAlwaysOnTop" Classes="chrome" Content="Pin"
                              IsCheckedChanged="ChatAlwaysOnTop_Changed"/>
                <Button Classes="chrome" Content="Pop out" Tag="chat" Click="PanelPopOut_Click"/>
              </StackPanel>
              <TextBlock Text="" IsVisible="False"/>
            </DockPanel>
            <Border Grid.Row="1" Classes="carbon inset" Padding="6" ClipToBounds="True">
              <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <ItemsControl x:Name="TranscriptList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Panel>
                          <Border Classes="bubble system" IsVisible="{Binding IsSystem}"
                                  Classes.system="True">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"/>
                          </Border>
                          <Grid Classes="msg-row" ColumnDefinitions="Auto,*,Auto"
                                IsVisible="{Binding ShowChatRow}">
                            <Border Classes="contact-bubble assistant"
                                    IsVisible="{Binding ShowLeftAvatar}">
                              <TextBlock Text="V" FontSize="12" FontWeight="Bold"
                                         Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1"
                                    Classes="bubble"
                                    Classes.user="{Binding IsUser}">
                              <StackPanel>
                                <Image Source="{Binding Image}" IsVisible="{Binding HasImage}"
                                       MaxHeight="240" MaxWidth="360" Stretch="Uniform" Margin="0,0,0,6"/>
                                <SelectableTextBlock Text="{Binding Text}" IsVisible="{Binding HasText}"
                                                     TextWrapping="Wrap"
                                                     SelectionBrush="{DynamicResource AccentDimBrush}"
                                                     PointerReleased="MessageText_PointerReleased">
                                  <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                      <MenuItem Header="Quote selection" Click="QuoteSelection_Click"/>
                                      <MenuItem Header="Quote message" Click="QuoteMessage_Click"/>
                                    </ContextMenu>
                                  </SelectableTextBlock.ContextMenu>
                                </SelectableTextBlock>
                                <Button Classes="chrome" Content="Quote"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2"
                                        FontSize="10" Tag="{Binding}"
                                        Click="QuoteMessageButton_Click"
                                        IsVisible="{Binding HasText}"/>
                                <TextBlock Text="{Binding DisplayTime}" FontSize="10" Margin="0,6,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                              </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="contact-bubble user"
                                    IsVisible="{Binding ShowRightAvatar}">
                              <TextBlock Text="K" FontSize="12" FontWeight="Bold"
                                         Foreground="{DynamicResource TextBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </Grid>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="TypingIndicator" Orientation="Horizontal" Spacing="4"
                              Margin="12,6,0,8" IsVisible="False">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource MutedBrush}" Opacity="0.7"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource MutedBrush}" Opacity="0.5"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource MutedBrush}" Opacity="0.35"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="10">
          <Border x:Name="VictoriaBrowserPanel" Classes="metal glass" Padding="8">
            <Grid RowDefinitions="Auto,*,Auto">
              <TextBlock Text="Her browser" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <Border Grid.Row="1" Classes="carbon inset" ClipToBounds="True" MinHeight="90">
                <Grid>
                  <TextBlock x:Name="VictoriaBrowserEmptyText"
                             Text="No Playwright frame yet"
                             Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                             Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <Image x:Name="VictoriaBrowserImage" Stretch="Uniform" IsVisible="False"/>
                </Grid>
              </Border>
              <StackPanel Grid.Row="2" Margin="0,6,0,0" Spacing="2">
                <TextBlock x:Name="VictoriaBrowserUrlText" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" Text="—"/>
                <TextBlock x:Name="VictoriaBrowserTitleText" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text=""/>
                <TextBlock x:Name="VictoriaBrowserActionText" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text=""/>
                <TextBlock x:Name="VictoriaBrowserWaitingText" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                           TextWrapping="Wrap" Text="" IsVisible="False"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- PROP-4 sight: frame + stamp + folder only -->
          <Border x:Name="ScreenPanel" Grid.Row="1" Classes="metal glass" Padding="8" Height="200">
            <Grid RowDefinitions="Auto,*,Auto">
              <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                  <ToggleButton x:Name="ScreenAlwaysOnTop" Classes="chrome" Content="Pin"
                                IsCheckedChanged="ScreenAlwaysOnTop_Changed"/>
                  <Button Classes="chrome" Content="⤢" Padding="8,3" Click="DesktopViewPopOut_Click"
                          ToolTip.Tip="Pop out sight"/>
                  <Button Classes="chrome" Content="📁" Padding="8,3" Click="DesktopViewOpenFolder_Click"
                          ToolTip.Tip="Open scratch sight gallery (not memory copies)"/>
                </StackPanel>
                <TextBlock Text="What she saw" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <Border Grid.Row="1" Classes="carbon inset" ClipToBounds="True">
                <Grid x:Name="DesktopViewSurface" SizeChanged="DesktopViewSurface_SizeChanged">
                  <TextBlock x:Name="DesktopViewEmptyText" Text="No still yet"
                             Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                             Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <Image x:Name="DesktopViewImage" Stretch="Uniform" IsVisible="False"/>
                  <Canvas x:Name="DesktopViewCursorLayer" IsHitTestVisible="False" IsVisible="False">
                    <Ellipse x:Name="DesktopViewCursor" Width="16" Height="16"
                             Stroke="#C4B06A" StrokeThickness="2" Fill="#55C4B06A"/>
                  </Canvas>
                </Grid>
              </Border>
              <DockPanel Grid.Row="2" Margin="0,6,0,0">
                <TextBlock x:Name="DesktopViewStampText" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" Text="—"/>
                <!-- Kept for code-behind compatibility (hidden) -->
                <StackPanel IsVisible="False">
                  <TextBlock x:Name="DesktopViewActionText"/>
                  <TextBlock x:Name="DesktopViewMetaText"/>
                  <TextBlock x:Name="DesktopViewPathText"/>
                  <StackPanel x:Name="DesktopViewGalleryPanel" Orientation="Horizontal"/>
                </StackPanel>
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="1" Classes="metal glass" Padding="10" Margin="0,8,0,0">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="chrome" Content="Attach" Click="AttachImage_Click"
                    ToolTip.Tip="Attach image (MMS outbound)"/>
            <Button x:Name="PttButton" Classes="primary" Content="Hold to talk"
                    ToolTip.Tip="Push-to-talk — mic → Host STT"/>
            <Button Classes="ghost" Content="Video"
                    ToolTip.Tip="WebRTC deferred — entry point lives in chat"/>
            <Border x:Name="PendingImageChip" Classes="carbon" Padding="8,4" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="PendingImageLabel" Text="image" FontSize="11" VerticalAlignment="Center"/>
                <Button Classes="chrome" Content="×" Padding="6,1" Click="ClearPendingImage_Click"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="PttHintText" Text="" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <Border x:Name="QuoteChip" Classes="carbon" Padding="10,6" IsVisible="False">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="chrome" Content="×" Padding="6,1"
                      Click="ClearQuote_Click" ToolTip.Tip="Clear quote"/>
              <StackPanel>
                <TextBlock Text="Replying to excerpt" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="QuoteChipText" FontSize="11" TextWrapping="Wrap" MaxHeight="64"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right" Classes="primary" Content="Send" Width="96"
                    Margin="10,0,0,0" Click="Send_Click"/>
            <TextBox x:Name="ChatInput" Classes="input" AcceptsReturn="False" Height="40"
                     VerticalContentAlignment="Center" Padding="10,0" Watermark="Message Victoria…"
                     KeyDown="ChatInput_KeyDown"/>
          </DockPanel>
        </Grid>
      </Border>

      <!-- PROP-4 House drawer: closed rail + open lamp tray -->
      <Border Grid.Row="2" Classes="metal glass" Margin="0,8,0,0" Padding="0">
        <Grid RowDefinitions="Auto,Auto">
          <Button x:Name="HouseDrawerTab" Classes="house-tab" HorizontalAlignment="Stretch"
                  Click="HouseDrawerToggle_Click">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <TextBlock Text="HOUSE" FontWeight="SemiBold" FontSize="12" LetterSpacing="2"
                         VerticalAlignment="Center"/>
              <Ellipse x:Name="HouseDrawerPip" Width="8" Height="8" Fill="Transparent"
                       VerticalAlignment="Center"/>
              <TextBlock x:Name="HouseDrawerChevron" Text="▴" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Border x:Name="ServicesPanel" Grid.Row="1" Classes="house-drawer-body" IsVisible="False"
                  Padding="16,10,16,14">
            <Grid RowDefinitions="Auto,Auto">
              <UniformGrid Columns="6" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowSoulCore" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampSoulCore" Classes="lamp" Tag="soulcore"
                              PointerPressed="LampSoulCore_PointerPressed"
                            PointerReleased="LampSoulCore_PointerReleased"
                            Click="LampClick_Click"
                            ToolTip.Tip="SoulCore Host — click to start; hold ~1.5s to stop"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="SOULCORE" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock x:Name="LampSoulCoreHint" Text="HOLD TO GUARD" FontSize="9"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Opacity="0.7"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowOllama" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampOllama" Classes="lamp" Tag="ollama"
                              Click="LampClick_Click"
                            ToolTip.Tip="Ollama"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="OLLAMA" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowUnreal" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampUnreal" Classes="lamp" Tag="unreal" IsEnabled="False"
                              ToolTip.Tip="Unreal avatar bridge (status only)"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="UNREAL" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowComfy" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampComfy" Classes="lamp" Tag="comfy" IsEnabled="False"
                              ToolTip.Tip="ComfyUI :8188"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="COMFY" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowCua" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampCua" Classes="lamp" Tag="cua"
                              Click="LampClick_Click"
                            ToolTip.Tip="CUA gate — click to toggle computer control"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="CUA" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowSandbox" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampSandbox" Classes="lamp" Tag="sandbox" IsEnabled="False"
                              ToolTip.Tip="victoria-sandbox VM"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="SANDBOX" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </UniformGrid>
              <TextBlock x:Name="ServicesStatusText" Grid.Row="1" Text="" FontSize="10"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                         HorizontalAlignment="Center"/>
              <!-- Compat shims for RefreshServicesPanelAsync until fully migrated -->
              <StackPanel IsVisible="False">
                <Ellipse x:Name="SvcHostDot"/><TextBlock x:Name="SvcHostStatus"/><TextBlock x:Name="SvcHostDetail"/>
                <Ellipse x:Name="SvcOllamaDot"/><TextBlock x:Name="SvcOllamaStatus"/><TextBlock x:Name="SvcOllamaDetail"/>
                <Ellipse x:Name="SvcCuaDot"/><TextBlock x:Name="SvcCuaStatus"/><TextBlock x:Name="SvcCuaDetail"/>
                <Ellipse x:Name="SvcUeDot"/><TextBlock x:Name="SvcUeStatus"/><TextBlock x:Name="SvcUeDetail"/>
                <Ellipse x:Name="SvcComfyDot"/><TextBlock x:Name="SvcComfyStatus"/><TextBlock x:Name="SvcComfyDetail"/>
                <ToggleButton x:Name="ServicesAlwaysOnTop"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="SettingsView" Margin="12" IsVisible="False">
      <Border Classes="metal glass" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Classes="frame-nav" Content="← BACK"
                    Click="OpenPresenceFromIdentity_Click" Margin="0,0,12,0"/>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
        <TabControl Grid.Row="1" Classes="settings-tabs" Background="Transparent" BorderThickness="0">
          <TabItem Header="Identity">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="Identity" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Her name" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                  <Button DockPanel.Dock="Right" Classes="ghost" Content="Save" Margin="8,0,0,0"
                          Click="IdentitySave_Click"/>
                  <TextBox x:Name="DisplayNameBox" Classes="input" MaxLength="64" Height="36"
                           VerticalContentAlignment="Center" Padding="8,0" LostFocus="DisplayNameBox_LostFocus"/>
                </DockPanel>
                <TextBlock Text="Detailed identity" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="IdentityDetailBox" Classes="input" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="160" Padding="10" Margin="0,0,0,12"
                         Text="Loading identity…"/>
                <TextBlock Text="Charter (from Host /health)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="IdentityCharterBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,12"/>
                <Button Classes="ghost" Content="← Back to chat" HorizontalAlignment="Left"
                        Click="OpenPresenceFromIdentity_Click"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Tools &amp; Access">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="Tools &amp; Access" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                           Text="Desktop and browser capture + computer control default ON (Kurt 2026-08-06). Backends moved to System."
                           Margin="0,0,0,16"/>
                <TextBlock Text="Desktop &amp; browser" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ToolsAllowDesktopCaptureCheck" Content="Allow desktop screenshots &amp; window list"
                          IsChecked="True" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowBrowserCaptureCheck" Content="Allow browser capture / health"
                          IsChecked="True" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowComputerControlCheck" Content="Allow computer control (click / type / key)"
                          IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsSoftCursorRestoreCheck" Content="Agent cursor — don't move my mouse"
                          IsChecked="True" Margin="0,0,0,16" Click="ToolsAccessToggle_Click"/>
                <TextBlock Text="Trading (MT4)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox x:Name="ToolsAllowMt4ReadCheck" Content="Allow MT4 read (status, symbols, positions)"
                          Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowMt4TradeCheck" Content="Allow MT4 trade / close / backtest"
                          Margin="0,0,0,16" Click="ToolsAccessToggle_Click"/>
                <TextBlock Text="Email gates" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox x:Name="ToolsAllowEmailReadCheck" Content="Allow email read / sort / mark (victoria + Kurt accounts)"
                          Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowEmailSendCheck" Content="Allow email send / reply (still asks Kurt to confirm)"
                          Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowEmailDeleteCheck" Content="Allow email delete (still asks Kurt to confirm)"
                          Margin="0,0,0,16" Click="ToolsAccessToggle_Click"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Content="Refresh" Click="ToolsAccessRefresh_Click"/>
                  <TextBlock x:Name="ToolsAccessStatusText" Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Email">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12" Spacing="6">
                <TextBlock Text="Email accounts" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                           Text="IMAP/SMTP credentials Victoria uses for victoria / personal / business. Passwords are write-only (leave blank to keep). Runtime file: %LOCALAPPDATA%/SoulCore/email-accounts.runtime.json"/>
                <TextBlock Text="Account" Foreground="{DynamicResource MutedBrush}"/>
                <ComboBox x:Name="EmailAccountCombo" Classes="input" Height="36"
                          SelectionChanged="EmailAccountCombo_SelectionChanged"/>
                <CheckBox x:Name="EmailEnabledCheck" Content="Enabled" Margin="0,4,0,4"/>
                <TextBlock Text="Display name" Foreground="{DynamicResource MutedBrush}"/>
                <TextBox x:Name="EmailDisplayNameBox" Classes="input" Height="34" Padding="8,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="Address" Foreground="{DynamicResource MutedBrush}"/>
                <TextBox x:Name="EmailAddressBox" Classes="input" Height="34" Padding="8,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="Username (blank = address)" Foreground="{DynamicResource MutedBrush}"/>
                <TextBox x:Name="EmailUsernameBox" Classes="input" Height="34" Padding="8,0"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="Password / app password" Foreground="{DynamicResource MutedBrush}"/>
                <TextBox x:Name="EmailPasswordBox" Classes="input" Height="34" Padding="8,0"
                         PasswordChar="•" VerticalContentAlignment="Center"
                         Watermark="Leave blank to keep current"/>
                <TextBlock x:Name="EmailPasswordHint" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                           Text="Password status: —"/>
                <TextBlock Text="IMAP host / port" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                <DockPanel>
                  <TextBox x:Name="EmailImapPortBox" DockPanel.Dock="Right" Classes="input" Width="72"
                           Height="34" Padding="8,0" VerticalContentAlignment="Center" Text="993" Margin="8,0,0,0"/>
                  <TextBox x:Name="EmailImapHostBox" Classes="input" Height="34" Padding="8,0"
                           VerticalContentAlignment="Center" Text="imap.gmail.com"/>
                </DockPanel>
                <CheckBox x:Name="EmailImapSslCheck" Content="IMAP SSL" IsChecked="True"/>
                <TextBlock Text="SMTP host / port" Foreground="{DynamicResource MutedBrush}"/>
                <DockPanel>
                  <TextBox x:Name="EmailSmtpPortBox" DockPanel.Dock="Right" Classes="input" Width="72"
                           Height="34" Padding="8,0" VerticalContentAlignment="Center" Text="587" Margin="8,0,0,0"/>
                  <TextBox x:Name="EmailSmtpHostBox" Classes="input" Height="34" Padding="8,0"
                           VerticalContentAlignment="Center" Text="smtp.gmail.com"/>
                </DockPanel>
                <CheckBox x:Name="EmailSmtpSslCheck" Content="SMTP implicit TLS (465); off = STARTTLS on 587"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                  <Button Classes="primary" Content="Save account" Click="EmailAccountSave_Click"/>
                  <Button Classes="ghost" Content="Refresh" Click="EmailAccountsRefresh_Click"/>
                  <TextBlock x:Name="EmailSettingsStatusText" Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="System">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <TextBlock Text="System" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Host endpoint" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemEndpointBox" Classes="input" IsReadOnly="True" Text="127.0.0.1:7700"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Bind address" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemBindBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Port" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemPortBox" Classes="input" IsReadOnly="True" Text="7700"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Inference" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemInferenceBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Memory path" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemMemoryPathBox" Classes="input" IsReadOnly="True" Text="—"
                         TextWrapping="Wrap" Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Memory open" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemMemoryOpenBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="SoulLoop" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemSoulLoopBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
                  <Button Classes="ghost" Content="Tick SoulLoop" Click="SoulLoopTick_Click"/>
                  <Button Classes="primary" Content="Reconnect WS" Click="SoulLoopRestart_Click"/>
                </StackPanel>
                <TextBlock Text="Backends (read-only from Host)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Desktop backend" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ToolsDesktopBackendBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,8"/>
                <TextBlock Text="Browser backend" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ToolsBrowserBackendBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,8"/>
                <TextBlock Text="MT4 backend" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ToolsMt4BackendBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,14"/>
                <Button Classes="ghost" Content="Refresh" HorizontalAlignment="Left" Click="RefreshSystem_Click"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Services">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12" Spacing="6">
                <TextBlock Text="Services" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           Text="Open the House drawer on Presence for SoulCore / Ollama / Unreal / Comfy / CUA / Sandbox lamps."
                           Margin="0,0,0,12"/>
                <Button Classes="ghost" Content="Refresh" Click="ServicesRefresh_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Notifications">
            <StackPanel Margin="12">
              <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                         Text="Sound when Victoria messages while the window is unfocused." Margin="0,0,0,16"/>
              <CheckBox x:Name="NotifEnabledCheckBox" Content="Enable notification sound" IsChecked="True"
                        Margin="0,0,0,12" Click="NotifEnabled_Click"/>
              <TextBlock Text="Sound file (.wav)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Browse…" Margin="8,0,0,0"
                        Click="NotifBrowse_Click"/>
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Clear" Margin="8,0,0,0"
                        Click="NotifClear_Click"/>
                <TextBox x:Name="NotifSoundPathBox" Classes="input" IsReadOnly="True"
                         Text="(system beep)" Padding="8,0"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Test sound" Click="NotifTest_Click"/>
                <TextBlock x:Name="NotifStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </TabItem>
        </TabControl>
        </Grid>
      </Border>
    </Grid>
      </DockPanel>
    </Grid>
  </Border>
  </Border>
</Window>
