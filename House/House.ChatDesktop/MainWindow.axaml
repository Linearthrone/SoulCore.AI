<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="House.ChatDesktop.MainWindow"
        Title="House Victoria — Presence"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TransparencyLevelHint="AcrylicBlur,Blur,None"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="carbon" Padding="14,8" CornerRadius="0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <Ellipse Classes="screw"/>
          <TextBlock Text="House Victoria" FontSize="20" FontWeight="Bold"
                     Foreground="{DynamicResource AccentBrush}" Margin="4,0,10,0" VerticalAlignment="Center"/>
          <RadioButton x:Name="NavPresence" Classes="nav" GroupName="Nav" Content="Presence"
                       IsChecked="True" IsCheckedChanged="Nav_Changed"/>
          <RadioButton x:Name="NavSettings" Classes="nav" GroupName="Nav" Content="Settings"
                       IsCheckedChanged="Nav_Changed"/>
          <Ellipse Classes="screw" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{DynamicResource BadBrush}"/>
          <TextBlock x:Name="ConnStatusText" Text="Connecting…" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center" FontSize="12"/>
          <Button Classes="chrome" Content="Refresh" Click="Refresh_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="PresenceView" Margin="14" RowDefinitions="Auto,*,Auto">
      <Border x:Name="HudPanel" Classes="metal" Padding="12" Margin="0,0,0,10" Opacity="0.96">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
              <ToggleButton x:Name="HudAlwaysOnTop" Classes="chrome" Content="Always on top"
                            IsCheckedChanged="HudAlwaysOnTop_Changed"/>
              <Button Classes="chrome" Content="Pop out" Tag="hud" Click="PanelPopOut_Click"/>
              <Ellipse Classes="screw"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Classes="screw"/>
              <TextBlock Text="Victoria" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
              <TextBlock x:Name="EndpointText" Text="127.0.0.1:7700" Foreground="{DynamicResource MutedBrush}"
                         FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>

          <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="MOOD" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Ellipse x:Name="MoodColorDot" Width="12" Height="12" Fill="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="MoodLabelText" Text="—" FontSize="16" FontWeight="SemiBold"/>
              </StackPanel>
              <Button Classes="ghost" Content="Correct mood…" Margin="0,6,0,0" HorizontalAlignment="Left"
                      FontSize="11" Padding="8,3" Click="CorrectEmotion_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="LOW ↔ HIGH (valence)" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
              <ProgressBar x:Name="ValenceGauge" Classes="gauge" Value="0.5" Margin="0,8,0,4"/>
              <TextBlock x:Name="ValenceText" Text="0.0" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="CALM ↔ ACTIVATED" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
              <ProgressBar x:Name="ArousalGauge" Classes="gauge" Value="0" Margin="0,8,0,4"/>
              <TextBlock x:Name="ArousalText" Text="0.0" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
              <TextBlock Text="STATUS" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="PresenceStateText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
              <TextBlock x:Name="ActivityText" Text="—" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>

          <Border x:Name="EmotionCorrectPanel" Grid.Row="2" IsVisible="False" Classes="carbon"
                  Padding="12" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="Correct mood" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Grid ColumnDefinitions="90,*,48" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                <TextBlock Text="valence" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Slider x:Name="CorrectValenceSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" Margin="0,4"/>
                <TextBlock Grid.Column="2" Text="{Binding #CorrectValenceSlider.Value, StringFormat='{}{0:0.0}'}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Text="arousal" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Slider x:Name="CorrectArousalSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Margin="0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding #CorrectArousalSlider.Value, StringFormat='{}{0:0.0}'}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="2" Text="dominance" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Slider x:Name="CorrectDominanceSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Margin="0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding #CorrectDominanceSlider.Value, StringFormat='{}{0:0.0}'}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="3" Text="focus" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Slider x:Name="CorrectFocusSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Margin="0,4"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding #CorrectFocusSlider.Value, StringFormat='{}{0:0.0}'}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
              <TextBox x:Name="CorrectNoteBox" Classes="input" MaxLength="200" Height="34"
                       VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10" Watermark="short note"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="ghost" Content="Cancel" Click="CorrectEmotionCancel_Click"/>
                <Button Classes="primary" Content="Save" Click="CorrectEmotionSave_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="10">
        <Border x:Name="ChatPanel" Classes="metal" Padding="8" Opacity="0.97">
          <Grid RowDefinitions="Auto,*">
            <DockPanel Margin="4,2,4,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="ChatAlwaysOnTop" Classes="chrome" Content="Always on top"
                              IsCheckedChanged="ChatAlwaysOnTop_Changed"/>
                <Button Classes="chrome" Content="Pop out" Tag="chat" Click="PanelPopOut_Click"/>
                <Ellipse Classes="screw"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Classes="screw"/>
                <TextBlock Text="Messages" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Classes="carbon" Padding="6" ClipToBounds="True">
              <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <ItemsControl x:Name="TranscriptList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="bubble" Classes.user="{Binding IsUser}" Classes.system="{Binding IsSystem}">
                          <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                              <TextBlock Text="{Binding DisplayTime}" DockPanel.Dock="Right" FontSize="10"
                                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding DisplayRole}" FontSize="11"
                                         Foreground="{DynamicResource AccentBrush}"/>
                            </DockPanel>
                            <Image Source="{Binding Image}" IsVisible="{Binding HasImage}"
                                   MaxHeight="240" MaxWidth="360" Stretch="Uniform" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Text}" IsVisible="{Binding HasText}" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="TypingIndicator" Orientation="Horizontal" Spacing="4"
                              Margin="12,6,0,8" IsVisible="False">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource MutedBrush}" Opacity="0.7"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource MutedBrush}" Opacity="0.5"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource MutedBrush}" Opacity="0.35"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,220" RowSpacing="10">
          <Border x:Name="ServicesPanel" Classes="metal" Padding="10" Opacity="0.96">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                  <ToggleButton x:Name="ServicesAlwaysOnTop" Classes="chrome" Content="Pin"
                                IsCheckedChanged="ServicesAlwaysOnTop_Changed"/>
                  <Button Classes="chrome" Content="Pop out" Tag="services" Click="PanelPopOut_Click"/>
                  <Ellipse Classes="screw"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="screw"/>
                  <TextBlock Text="Services" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="6">
                  <Border Classes="carbon" Padding="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse x:Name="SvcHostDot" Width="9" Height="9" Fill="{DynamicResource MutedBrush}"/>
                          <TextBlock Text="Host" FontWeight="SemiBold"/>
                          <TextBlock x:Name="SvcHostStatus" Text="—" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="SvcHostDetail" Text=":7700" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Classes="chrome" Content="Start" Tag="host-start" Click="ServicesAction_Click"/>
                        <Button Classes="chrome" Content="Stop" Tag="host-stop" Click="ServicesAction_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="carbon" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse x:Name="SvcGuiDot" Width="9" Height="9" Fill="{DynamicResource OkBrush}"/>
                      <TextBlock Text="ChatDesktop" FontWeight="SemiBold"/>
                      <TextBlock Text="running" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </Border>
                  <Border Classes="carbon" Padding="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse x:Name="SvcOllamaDot" Width="9" Height="9" Fill="{DynamicResource MutedBrush}"/>
                          <TextBlock Text="Ollama" FontWeight="SemiBold"/>
                          <TextBlock x:Name="SvcOllamaStatus" Text="—" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="SvcOllamaDetail" Text=":11434" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="chrome" Content="Start" Tag="ollama-start" Click="ServicesAction_Click"/>
                    </Grid>
                  </Border>
                  <Border Classes="carbon" Padding="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Ellipse x:Name="SvcCuaDot" Width="9" Height="9" Fill="{DynamicResource MutedBrush}"/>
                          <TextBlock Text="CUA" FontWeight="SemiBold"/>
                          <TextBlock x:Name="SvcCuaStatus" Text="—" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="SvcCuaDetail" Text="computer-use" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Classes="chrome" Content="On" Tag="cua-enable" Click="ServicesAction_Click"/>
                        <Button Classes="chrome" Content="Off" Tag="cua-disable" Click="ServicesAction_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="carbon" Padding="8">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="SvcUeDot" Width="9" Height="9" Fill="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="Unreal" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SvcUeStatus" Text="—" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                      </StackPanel>
                      <TextBlock x:Name="SvcUeDetail" Text="avatar bridge" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Classes="carbon" Padding="8">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="SvcComfyDot" Width="9" Height="9" Fill="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="ComfyUI" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SvcComfyStatus" Text="—" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                      </StackPanel>
                      <TextBlock x:Name="SvcComfyDetail" Text=":8188" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Button Classes="ghost" Content="Refresh services" Click="ServicesRefresh_Click" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="ServicesStatusText" Text="" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border x:Name="ScreenPanel" Grid.Row="1" Classes="metal" Padding="8" Opacity="0.96">
            <Grid RowDefinitions="Auto,*,Auto">
              <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                  <ToggleButton x:Name="ScreenAlwaysOnTop" Classes="chrome" Content="Pin"
                                IsCheckedChanged="ScreenAlwaysOnTop_Changed"/>
                  <Button Classes="chrome" Content="Pop out" Click="DesktopViewPopOut_Click"/>
                  <Button Classes="chrome" Content="Folder" Click="DesktopViewOpenFolder_Click"
                          ToolTip.Tip="Open the temp screenshot gallery folder"/>
                  <Ellipse Classes="screw"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="screw"/>
                  <TextBlock Text="What she saw" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
              <Border Grid.Row="1" Classes="carbon" ClipToBounds="True" MinHeight="100">
                <Grid x:Name="DesktopViewSurface" SizeChanged="DesktopViewSurface_SizeChanged">
                  <TextBlock x:Name="DesktopViewEmptyText" Text="No capture yet — she must call eyes/desktop/browser tools"
                             Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                             Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <Image x:Name="DesktopViewImage" Stretch="Uniform" IsVisible="False"/>
                  <Canvas x:Name="DesktopViewCursorLayer" IsHitTestVisible="False" IsVisible="False">
                    <Ellipse x:Name="DesktopViewCursor" Width="16" Height="16"
                             Stroke="#C4B06A" StrokeThickness="2" Fill="#55C4B06A"/>
                  </Canvas>
                </Grid>
              </Border>
              <StackPanel Grid.Row="2" Margin="0,6,0,0" Spacing="4">
                <TextBlock x:Name="DesktopViewActionText" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text="Waiting…"/>
                <TextBlock x:Name="DesktopViewMetaText" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" Text=""/>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                    <Button Classes="ghost" Content="Open file" FontSize="10" Padding="6,2"
                            Click="DesktopViewOpenFile_Click"
                            ToolTip.Tip="Open the latest screenshot file"/>
                    <Button Classes="ghost" Content="Copy path" FontSize="10" Padding="6,2"
                            Click="DesktopViewCopyPath_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="DesktopViewPathText" FontSize="10"
                             Foreground="{DynamicResource AccentBrush}"
                             TextWrapping="Wrap" Text=""
                             ToolTip.Tip="Filesystem path of the latest capture"/>
                </DockPanel>
                <TextBlock Text="Temp gallery (click to inspect)" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              MaxHeight="52">
                  <StackPanel x:Name="DesktopViewGalleryPanel" Orientation="Horizontal" Spacing="4"/>
                </ScrollViewer>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Classes="metal" Padding="10" Margin="0,10,0,0" Opacity="0.97">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="screw"/>
            <Button Classes="chrome" Content="Attach" Click="AttachImage_Click"
                    ToolTip.Tip="Attach image (MMS outbound)"/>
            <Button x:Name="PttButton" Classes="primary" Content="Hold to talk"
                    ToolTip.Tip="Push-to-talk — mic → Host STT"/>
            <Button Classes="ghost" Content="Video"
                    ToolTip.Tip="WebRTC deferred — entry point lives in chat"/>
            <Border x:Name="PendingImageChip" Classes="carbon" Padding="8,4" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="PendingImageLabel" Text="image" FontSize="11" VerticalAlignment="Center"/>
                <Button Classes="chrome" Content="×" Padding="6,1" Click="ClearPendingImage_Click"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="PttHintText" Text="" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <DockPanel Grid.Row="1">
            <Button DockPanel.Dock="Right" Classes="primary" Content="Send" Width="96"
                    Margin="10,0,0,0" Click="Send_Click"/>
            <TextBox x:Name="ChatInput" Classes="input" AcceptsReturn="False" Height="40"
                     VerticalContentAlignment="Center" Padding="10,0" Watermark="Message Victoria…"
                     KeyDown="ChatInput_KeyDown"/>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="SettingsView" Margin="14" IsVisible="False">
      <Border Classes="metal" Padding="8" Opacity="0.97">
        <TabControl Background="Transparent" BorderThickness="0">
          <TabItem Header="Identity">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <Ellipse Classes="screw"/>
                  <TextBlock Text="Identity" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Her name" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                  <Button DockPanel.Dock="Right" Classes="ghost" Content="Save" Margin="8,0,0,0"
                          Click="IdentitySave_Click"/>
                  <TextBox x:Name="DisplayNameBox" Classes="input" MaxLength="64" Height="36"
                           VerticalContentAlignment="Center" Padding="8,0" LostFocus="DisplayNameBox_LostFocus"/>
                </DockPanel>
                <TextBlock Text="Detailed identity" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="IdentityDetailBox" Classes="input" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="160" Padding="10" Margin="0,0,0,12"
                         Text="Loading identity…"/>
                <TextBlock Text="Charter (from Host /health)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="IdentityCharterBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,12"/>
                <Button Classes="ghost" Content="Open Presence →" HorizontalAlignment="Left"
                        Click="OpenPresenceFromIdentity_Click"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Tools &amp; Access">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <Ellipse Classes="screw"/>
                  <TextBlock Text="Tools &amp; Access" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                           Text="Desktop and browser capture + computer control default ON (Kurt 2026-08-06). Backends moved to System."
                           Margin="0,0,0,16"/>
                <TextBlock Text="Desktop &amp; browser" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ToolsAllowDesktopCaptureCheck" Content="Allow desktop screenshots &amp; window list"
                          IsChecked="True" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowBrowserCaptureCheck" Content="Allow browser capture / health"
                          IsChecked="True" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowComputerControlCheck" Content="Allow computer control (click / type / key)"
                          IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsSoftCursorRestoreCheck" Content="Agent cursor — don't move my mouse"
                          IsChecked="True" Margin="0,0,0,16" Click="ToolsAccessToggle_Click"/>
                <TextBlock Text="Trading (MT4)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox x:Name="ToolsAllowMt4ReadCheck" Content="Allow MT4 read (status, symbols, positions)"
                          Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowMt4TradeCheck" Content="Allow MT4 trade / close / backtest"
                          Margin="0,0,0,16" Click="ToolsAccessToggle_Click"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Content="Refresh" Click="ToolsAccessRefresh_Click"/>
                  <TextBlock x:Name="ToolsAccessStatusText" Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="System">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                  <Ellipse Classes="screw"/>
                  <TextBlock Text="System" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Host endpoint" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemEndpointBox" Classes="input" IsReadOnly="True" Text="127.0.0.1:7700"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Bind address" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemBindBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Port" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemPortBox" Classes="input" IsReadOnly="True" Text="7700"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Inference" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemInferenceBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Memory path" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemMemoryPathBox" Classes="input" IsReadOnly="True" Text="—"
                         TextWrapping="Wrap" Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="Memory open" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemMemoryOpenBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,10"/>
                <TextBlock Text="SoulLoop" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="SystemSoulLoopBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
                  <Button Classes="ghost" Content="Tick SoulLoop" Click="SoulLoopTick_Click"/>
                  <Button Classes="primary" Content="Reconnect WS" Click="SoulLoopRestart_Click"/>
                </StackPanel>
                <TextBlock Text="Backends (read-only from Host)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Desktop backend" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ToolsDesktopBackendBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,8"/>
                <TextBlock Text="Browser backend" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ToolsBrowserBackendBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,8"/>
                <TextBlock Text="MT4 backend" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="ToolsMt4BackendBox" Classes="input" IsReadOnly="True" Text="—"
                         Padding="8" Margin="0,0,0,14"/>
                <Button Classes="ghost" Content="Refresh" HorizontalAlignment="Left" Click="RefreshSystem_Click"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Services">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12" Spacing="6">
                <TextBlock Text="Services" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           Text="Same stack as the Presence services dock. Prefer Presence for day-to-day status."
                           Margin="0,0,0,12"/>
                <Button Classes="ghost" Content="Refresh" Click="ServicesRefresh_Click" HorizontalAlignment="Left"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Notifications">
            <StackPanel Margin="12">
              <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                         Text="Sound when Victoria messages while the window is unfocused." Margin="0,0,0,16"/>
              <CheckBox x:Name="NotifEnabledCheckBox" Content="Enable notification sound" IsChecked="True"
                        Margin="0,0,0,12" Click="NotifEnabled_Click"/>
              <TextBlock Text="Sound file (.wav)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Browse…" Margin="8,0,0,0"
                        Click="NotifBrowse_Click"/>
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Clear" Margin="8,0,0,0"
                        Click="NotifClear_Click"/>
                <TextBox x:Name="NotifSoundPathBox" Classes="input" IsReadOnly="True"
                         Text="(system beep)" Padding="8,0"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Test sound" Click="NotifTest_Click"/>
                <TextBlock x:Name="NotifStatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
