<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="House.ChatDesktop.MainWindow"
        Title="House Victoria — Presence"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        TransparencyLevelHint="Transparent,AcrylicBlur,Blur,None"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/house-victoria.ico">
  <!-- Frameless shell — thick metal bevel (dark→bright→dark refraction) -->
  <Border Classes="shell-bevel" Margin="4">
  <Border Classes="shell">
    <Grid>
      <Border Classes="shell-inner"/>
      <Border Classes="shell-rim" Margin="1"/>
      <DockPanel Margin="0">
        <!-- Title / identity frame strip (drag region) -->
        <Border x:Name="TitleDragRegion" DockPanel.Dock="Top" Padding="16,12,12,8"
                Background="Transparent" PointerPressed="TitleDragRegion_PointerPressed"
                DoubleTapped="TitleDragRegion_DoubleTapped">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <Border Width="36" Height="36" CornerRadius="8" Background="#1A1C20"
                      BorderBrush="{DynamicResource MetalBevelBrush}" BorderThickness="1.5">
                <TextBlock Text="HV" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="IdentityNameText" Text="Victoria" FontWeight="SemiBold" FontSize="16"/>
                  <Ellipse x:Name="MoodColorDot" Width="8" Height="8" Fill="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>
                  <TextBlock x:Name="MoodLabelText" Text="—" FontSize="12" FontWeight="SemiBold"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{DynamicResource BadBrush}"
                           VerticalAlignment="Center"/>
                  <TextBlock x:Name="PresenceStateText" Text="—" FontSize="11"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="·" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                  <TextBlock x:Name="ActivityText" Text="—" FontSize="11" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" MaxWidth="380"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
              <!-- brand center-ish -->
              <StackPanel Margin="24,0,0,0" VerticalAlignment="Center" Opacity="0.85">
                <TextBlock Text="HOUSE VICTORIA" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource MutedBrush}" LetterSpacing="1.5"/>
                <TextBlock x:Name="EndpointText" Text="127.0.0.1:7700" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" Opacity="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="BuildVersionsText" Text="" FontSize="10"
                             Foreground="{DynamicResource AccentBrush}" Opacity="0.9"
                             VerticalAlignment="Center"/>
                  <!-- PROP-16 / PROP-17.4: update mark opens System (not title-bar Update) -->
                  <Button x:Name="UpdateAvailableMark" Classes="chrome" Content="● update"
                          FontSize="10" Padding="8,2" IsVisible="False"
                          Click="UpdateAvailableMark_Click"
                          ToolTip.Tip="Update available — open Settings → System"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Settings only on the frame (Update / Restart / Correct mood / Refresh removed) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
              <Button x:Name="NavSettings" Classes="frame-nav" Content="SETTINGS"
                      Click="NavSettings_Click"/>
              <TextBlock x:Name="ConnStatusText" Text="" IsVisible="False"/>
              <!-- Compat shims for code-behind -->
              <RadioButton x:Name="NavPresence" IsVisible="False" IsChecked="True"/>
              <Border Classes="mood-gem-well" Width="1" Height="1" IsVisible="False"/>
              <ToggleButton x:Name="HudAlwaysOnTop" IsVisible="False"/>
              <Button x:Name="NavUpdate" IsVisible="False" Click="UpdateNow_Click"/>
              <Button x:Name="NavRestartStack" IsVisible="False" Click="RestartStack_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
              <Button Classes="window-chrome" Content="─" Click="Minimize_Click"
                      ToolTip.Tip="Minimize"/>
              <Button x:Name="MaximizeButton" Classes="window-chrome" Content="□" Click="Maximize_Click"
                      ToolTip.Tip="Maximize"/>
              <Button Classes="window-chrome close" Content="✕" Click="Close_Click"
                      ToolTip.Tip="Close"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- PROP-4.2: update toast (auto-check + manual Update) -->
        <Border x:Name="UpdateToastBar" DockPanel.Dock="Top" IsVisible="False"
                Classes="carbon glass" Padding="12,8" Margin="12,0,12,8">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="ghost" Content="Dismiss" Margin="8,0,0,0"
                    Click="UpdateToastDismiss_Click"/>
            <Button x:Name="UpdateToastActionButton" DockPanel.Dock="Right" Classes="primary"
                    Content="Update" Margin="8,0,0,0" Click="UpdateApply_Click"/>
            <TextBlock x:Name="UpdateToastText" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Update available"/>
          </DockPanel>
        </Border>

        <!-- Correct-mood panel (shared, overlays under strip) -->
        <Border x:Name="HudPanel" DockPanel.Dock="Top" IsVisible="False" Margin="12,0,12,0"/>
        <Border x:Name="EmotionCorrectPanel" DockPanel.Dock="Top" IsVisible="False" Classes="carbon glass"
                Padding="12" Margin="12,0,12,8">
          <StackPanel>
            <TextBlock Text="Correct mood" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Grid ColumnDefinitions="90,*,48" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,8">
              <TextBlock Text="valence" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectValenceSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" Margin="0,4"/>
              <TextBlock Grid.Column="2" Text="{Binding #CorrectValenceSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="1" Text="arousal" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectArousalSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Margin="0,4"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding #CorrectArousalSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="2" Text="dominance" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectDominanceSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Margin="0,4"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding #CorrectDominanceSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
              <TextBlock Grid.Row="3" Text="focus" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectFocusSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Margin="0,4"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding #CorrectFocusSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="False">
              <ProgressBar x:Name="ValenceGauge" Classes="gauge" Value="0.5" Width="80"/>
              <TextBlock x:Name="ValenceText" Text="0.0"/>
              <ProgressBar x:Name="ArousalGauge" Classes="gauge" Value="0" Width="80"/>
              <TextBlock x:Name="ArousalText" Text="0.0"/>
            </StackPanel>
            <TextBox x:Name="CorrectNoteBox" Classes="input" MaxLength="200" Height="34"
                     VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10" Watermark="short note"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Classes="ghost" Content="Cancel" Click="CorrectEmotionCancel_Click"/>
              <Button Classes="primary" Content="Save" Click="CorrectEmotionSave_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

    <Grid x:Name="PresenceView" Margin="12,4,12,0" RowDefinitions="*,Auto,Auto">
      <!-- Pixel Her screen + Avalonia-only east grip (col 3). VM HWND steals hits on window ResizeEast. -->
      <Grid x:Name="PresenceMainSplit" Grid.Row="0" ColumnDefinitions="*,6,520,10">
        <Border x:Name="ChatPanel" Classes="metal glass" Padding="8" MinWidth="320">
          <!-- PROP-17.4: composer inside ChatPanel so pop-out includes draft / Hold to talk / Send -->
          <Grid RowDefinitions="Auto,*,Auto">
            <DockPanel Margin="4,2,4,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="ChatAlwaysOnTop" Classes="chrome" Content="Pin"
                              IsCheckedChanged="ChatAlwaysOnTop_Changed"/>
                <Button Classes="chrome" Content="Pop out" Tag="chat" Click="PanelPopOut_Click"/>
              </StackPanel>
              <TextBlock Text="" IsVisible="False"/>
            </DockPanel>
            <Border Grid.Row="1" Classes="carbon inset" Padding="6" ClipToBounds="True">
              <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <ItemsControl x:Name="TranscriptList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Panel>
                          <Border Classes="bubble system" IsVisible="{Binding IsSystem}"
                                  Classes.system="True">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"/>
                          </Border>
                          <Grid Classes="msg-row" ColumnDefinitions="Auto,*,Auto"
                                IsVisible="{Binding ShowChatRow}">
                            <Border Classes="contact-bubble assistant"
                                    IsVisible="{Binding ShowLeftAvatar}">
                              <TextBlock Text="V" FontSize="12" FontWeight="Bold"
                                         Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1"
                                    Classes="bubble"
                                    Classes.user="{Binding IsUser}">
                              <StackPanel>
                                <Image Source="{Binding Image}" IsVisible="{Binding HasImage}"
                                       MaxHeight="240" MaxWidth="360" Stretch="Uniform" Margin="0,0,0,6"/>
                                <SelectableTextBlock Text="{Binding Text}" IsVisible="{Binding HasText}"
                                                     TextWrapping="Wrap"
                                                     SelectionBrush="{DynamicResource AccentDimBrush}"
                                                     PointerReleased="MessageText_PointerReleased">
                                  <SelectableTextBlock.ContextMenu>
                                    <ContextMenu>
                                      <MenuItem Header="Quote selection" Click="QuoteSelection_Click"/>
                                      <MenuItem Header="Quote message" Click="QuoteMessage_Click"/>
                                    </ContextMenu>
                                  </SelectableTextBlock.ContextMenu>
                                </SelectableTextBlock>
                                <Button Classes="chrome" Content="Quote"
                                        HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2"
                                        FontSize="10" Tag="{Binding}"
                                        Click="QuoteMessageButton_Click"
                                        IsVisible="{Binding HasText}"/>
                                <TextBlock Text="{Binding DisplayTime}" FontSize="10" Margin="0,6,0,0"
                                           Foreground="{DynamicResource MutedBrush}"/>
                              </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="contact-bubble user"
                                    IsVisible="{Binding ShowRightAvatar}">
                              <TextBlock Text="K" FontSize="12" FontWeight="Bold"
                                         Foreground="{DynamicResource TextBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </Grid>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="TypingIndicator" Orientation="Horizontal" Spacing="6"
                              Margin="12,6,0,8" IsVisible="False">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0.9"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0.6"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0.35"/>
                    <TextBlock x:Name="TypingLabel" Text="Thinking" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Classes="carbon" Padding="8" Margin="0,8,0,0">
              <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="chrome" Content="Attach" Click="AttachImage_Click"
                          ToolTip.Tip="Attach image (MMS outbound)"/>
                  <Button x:Name="PttButton" Classes="primary" Content="Hold to talk"
                          ToolTip.Tip="Push-to-talk — mic → Host STT"/>
                  <Button Classes="ghost" Content="Video"
                          ToolTip.Tip="WebRTC deferred — entry point lives in chat"/>
                  <Border x:Name="PendingImageChip" Classes="carbon" Padding="8,4" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock x:Name="PendingImageLabel" Text="image" FontSize="11" VerticalAlignment="Center"/>
                      <Button Classes="chrome" Content="×" Padding="6,1" Click="ClearPendingImage_Click"/>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="PttHintText" Text="" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="VoiceHealthCompactText" Text="" FontSize="10"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="QuoteChip" Classes="carbon" Padding="10,6" IsVisible="False">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="chrome" Content="×" Padding="6,1"
                            Click="ClearQuote_Click" ToolTip.Tip="Clear quote"/>
                    <StackPanel>
                      <TextBlock Text="Replying to excerpt" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock x:Name="QuoteChipText" FontSize="11" TextWrapping="Wrap" MaxHeight="64"
                                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <DockPanel Grid.Row="2">
                  <Button DockPanel.Dock="Right" Classes="primary" Content="Send" Width="96"
                          Margin="10,0,0,0" Click="Send_Click"/>
                  <TextBox x:Name="ChatInput" Classes="input" AcceptsReturn="True"
                           TextWrapping="Wrap" MinHeight="40" MaxHeight="140"
                           VerticalContentAlignment="Top" Padding="10,8"
                           Watermark="Message Victoria…"
                           KeyDown="ChatInput_KeyDown"
                           TextChanged="ChatInput_TextChanged"/>
                </DockPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <GridSplitter x:Name="PresenceColumnSplitter" Grid.Column="1" Width="6"
                      ResizeDirection="Columns" ShowsPreview="False"
                      Background="#44FFFFFF" MinWidth="6"
                      Cursor="SizeWestEast"
                      ToolTip.Tip="Drag left to widen Her screen (takes space from chat)"/>

        <!-- Her screen + What she saw share one column via tabs (no vertical splitter). -->
        <Border x:Name="PresenceSideSplit" Grid.Column="2" Classes="metal glass" Padding="8" MinWidth="200" MinHeight="120">
          <TabControl x:Name="PresenceSideTabs" Classes="settings-tabs"
                      Background="Transparent" BorderThickness="0"
                      SelectionChanged="PresenceSideTabs_SelectionChanged">
            <TabItem x:Name="HerScreenTab" Header="Her screen">
              <Border x:Name="VictoriaBrowserPanel" Background="Transparent" Padding="0,8,0,0">
                <Grid RowDefinitions="*,Auto">
                  <Border x:Name="VictoriaBrowserSurface" Classes="carbon inset" ClipToBounds="True" MinHeight="90"
                          PointerMoved="VictoriaBrowserSurface_PointerMoved"
                          PointerExited="VictoriaBrowserSurface_PointerExited"
                          PointerPressed="VictoriaBrowserSurface_PointerPressed"
                          ToolTip.Tip="VM embed: live VirtualBox + her pink/teal cursor. Badge: her (x,y) always; you click (x,y) while hovering. Clicks go to the VM. JPEG: hover to copy click (x,y).">
                    <Grid>
                      <TextBlock x:Name="VictoriaBrowserEmptyText"
                                 Text="Waiting for Victoria's browser — pink cursor idle, teal on click"
                                 Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                 Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      <Image x:Name="VictoriaBrowserImage" Stretch="Uniform" IsVisible="False"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                      <!-- NativeControlHost is created only when embedding — cold start must not
                           hit Win32 CreateWindowEx (needs app.manifest; still defer as belt/suspenders). -->
                      <Panel x:Name="VictoriaBrowserEmbedSlot"
                             IsVisible="False"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                      <!-- Soft cursor + badge: JPEG path uses these in-tree layers.
                           Live VM HWND paints above Avalonia — BrowserView opens a
                           click-through owned overlay window for cursor/coords then. -->
                      <Canvas x:Name="VictoriaBrowserCursorLayer" IsHitTestVisible="False" IsVisible="False">
                        <Ellipse x:Name="VictoriaBrowserCursor" Width="28" Height="28"
                                 Stroke="#FFFF2D55" StrokeThickness="3"
                                 Fill="#73FF2D55"/>
                      </Canvas>
                      <Border x:Name="VictoriaBrowserCoordBadge" IsVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Top"
                              Margin="8" Padding="8,4" CornerRadius="4"
                              Background="#CC0A0A0A" BorderBrush="#FFFF2D55" BorderThickness="1"
                              IsHitTestVisible="False">
                        <TextBlock x:Name="VictoriaBrowserCoordText"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFFF2D55"
                                   Text="click (0, 0)"/>
                      </Border>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Row="1" Margin="0,6,0,0" Spacing="2">
                    <TextBlock x:Name="VictoriaBrowserUrlText" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap" Text="—"/>
                    <TextBlock x:Name="VictoriaBrowserTitleText" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Text=""/>
                    <TextBlock x:Name="VictoriaBrowserActionText" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Text=""/>
                    <TextBlock x:Name="VictoriaBrowserWaitingText" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap" Text="" IsVisible="False"/>
                  </StackPanel>
                </Grid>
              </Border>
            </TabItem>

            <TabItem x:Name="SightTab" Header="What she saw">
              <!-- PROP-4 sight: frame + stamp + folder (same column as Her screen). -->
              <Border x:Name="ScreenPanel" Background="Transparent" Padding="0,8,0,0">
                <Grid RowDefinitions="Auto,*,Auto">
                  <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                      <ToggleButton x:Name="ScreenAlwaysOnTop" Classes="chrome" Content="Pin"
                                    IsCheckedChanged="ScreenAlwaysOnTop_Changed"/>
                      <Button Classes="chrome" Content="⤢" Padding="8,3" Click="DesktopViewPopOut_Click"
                              ToolTip.Tip="Pop out sight"/>
                      <Button Classes="chrome" Content="📁" Padding="8,3" Click="DesktopViewOpenFolder_Click"
                              ToolTip.Tip="Open scratch sight gallery (not memory copies)"/>
                    </StackPanel>
                    <TextBlock Text="Last capture" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                  <Border Grid.Row="1" Classes="carbon inset" ClipToBounds="True" MinHeight="90">
                    <Grid x:Name="DesktopViewSurface" SizeChanged="DesktopViewSurface_SizeChanged">
                      <TextBlock x:Name="DesktopViewEmptyText" Text="No still yet"
                                 Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                 Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                      <Image x:Name="DesktopViewImage" Stretch="Uniform" IsVisible="False"/>
                      <Canvas x:Name="DesktopViewCursorLayer" IsHitTestVisible="False" IsVisible="False">
                        <Ellipse x:Name="DesktopViewCursor" Width="16" Height="16"
                                 Stroke="#C4B06A" StrokeThickness="2" Fill="#55C4B06A"/>
                      </Canvas>
                    </Grid>
                  </Border>
                  <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <TextBlock x:Name="DesktopViewStampText" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Text="—"/>
                    <!-- Kept for code-behind compatibility (hidden) -->
                    <StackPanel IsVisible="False">
                      <TextBlock x:Name="DesktopViewActionText"/>
                      <TextBlock x:Name="DesktopViewMetaText"/>
                      <TextBlock x:Name="DesktopViewPathText"/>
                      <StackPanel x:Name="DesktopViewGalleryPanel" Orientation="Horizontal"/>
                    </StackPanel>
                  </DockPanel>
                </Grid>
              </Border>
            </TabItem>
          </TabControl>
        </Border>

        <!-- Right of VM: Avalonia grip the HWND cannot cover — drag right to expand embed. -->
        <Border x:Name="HerScreenEastResizeGrip" Grid.Column="3"
                Background="#55C4B06A" Cursor="SizeWestEast" MinWidth="10"
                ToolTip.Tip="Drag right to widen Her screen / VM embed (window grows with it)"
                PointerPressed="HerScreenEastResize_PointerPressed"
                PointerMoved="HerScreenEastResize_PointerMoved"
                PointerReleased="HerScreenEastResize_PointerReleased"
                PointerCaptureLost="HerScreenEastResize_PointerCaptureLost"/>
      </Grid>

      <!-- PROP-17.4: activity band always under the main split (composer moved into ChatPanel) -->
      <Border x:Name="ActivityBand" Grid.Row="1" Classes="metal glass" Padding="12,10" Margin="0,8,0,0">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel Spacing="4">
            <TextBlock x:Name="BandDoingText" FontSize="12" TextWrapping="Wrap"
                       Text="Doing — waiting for Host…"/>
            <TextBlock x:Name="BandOnHerMindText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="On her mind — quiet between talks (interest status awaits PROP-17.3)"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="BandMoodText" FontSize="12" VerticalAlignment="Center"
                         Text="Mood — —"/>
              <Button Classes="chrome" Content="Correct mood…" FontSize="10" Padding="8,2"
                      Click="CorrectEmotion_Click"
                      ToolTip.Tip="Disclosure in the band — not title chrome"/>
            </StackPanel>
            <TextBlock x:Name="BandInfluencesText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Influences — none yet"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4" MinWidth="200" Margin="16,0,0,0">
            <TextBlock Text="Tasks" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="BandTasksText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Ledger statuses await Host PROP-17.1 (parked / suspended / release)."/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="chrome" Content="Add" FontSize="10" Padding="8,2" IsEnabled="False"
                      ToolTip.Tip="Disabled until PROP-17.1 task APIs exist"/>
              <Button Classes="chrome" Content="Suspend" FontSize="10" Padding="8,2" IsEnabled="False"
                      ToolTip.Tip="Disabled until PROP-17.1 task APIs exist"/>
              <Button Classes="chrome" Content="Release" FontSize="10" Padding="8,2" IsEnabled="False"
                      ToolTip.Tip="Disabled until PROP-17.1 task APIs exist"/>
            </StackPanel>
          </StackPanel>
          <Border x:Name="EmotionCorrectInlineHost" Grid.Row="1" Grid.ColumnSpan="2"
                  Margin="0,8,0,0" IsVisible="False"/>
        </Grid>
      </Border>

      <!-- PROP-4 House drawer: closed rail + open lamp tray -->
      <Border Grid.Row="2" Classes="metal glass" Margin="0,8,0,0" Padding="0">
        <Grid RowDefinitions="Auto,Auto">
          <Button x:Name="HouseDrawerTab" Classes="house-tab" HorizontalAlignment="Stretch"
                  Click="HouseDrawerToggle_Click">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <TextBlock Text="HOUSE" FontWeight="SemiBold" FontSize="12" LetterSpacing="2"
                         VerticalAlignment="Center"/>
              <Ellipse x:Name="HouseDrawerPip" Width="8" Height="8" Fill="Transparent"
                       VerticalAlignment="Center"/>
              <TextBlock x:Name="HouseDrawerChevron" Text="▴" FontSize="11"
                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Border x:Name="ServicesPanel" Grid.Row="1" Classes="house-drawer-body" IsVisible="False"
                  Padding="16,10,16,14">
            <Grid RowDefinitions="Auto,Auto">
              <UniformGrid Columns="6" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowSoulCore" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampSoulCore" Classes="lamp" Tag="soulcore"
                              PointerPressed="LampSoulCore_PointerPressed"
                            PointerReleased="LampSoulCore_PointerReleased"
                            Click="LampClick_Click"
                            ToolTip.Tip="SoulCore Host — click to start; hold ~1.5s to stop"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="SOULCORE" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock x:Name="LampSoulCoreHint" Text="HOLD TO GUARD" FontSize="9"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Opacity="0.7"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowOllama" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampOllama" Classes="lamp" Tag="ollama"
                              Click="LampClick_Click"
                            ToolTip.Tip="Ollama"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="OLLAMA" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowUnreal" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampUnreal" Classes="lamp" Tag="unreal" IsEnabled="False"
                              ToolTip.Tip="Unreal avatar bridge (status only)"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="UNREAL" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowComfy" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampComfy" Classes="lamp" Tag="comfy" IsEnabled="False"
                              ToolTip.Tip="ComfyUI :8188"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="COMFY" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowCua" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampCua" Classes="lamp" Tag="cua"
                              Click="LampClick_Click"
                            ToolTip.Tip="CUA gate — click to toggle computer control"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="CUA" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Spacing="6" Margin="4">
                  <Border Classes="lamp-well">
                    <Panel Width="52" Height="52">
                      <Ellipse x:Name="GlowSandbox" Width="52" Height="52" IsHitTestVisible="False"/>
                      <Button x:Name="LampSandbox" Classes="lamp" Tag="sandbox" IsEnabled="False"
                              ToolTip.Tip="victoria-sandbox VM"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Panel>
                  </Border>
                  <TextBlock Text="SANDBOX" FontSize="10" FontWeight="SemiBold"
                             HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </UniformGrid>
              <TextBlock x:Name="ServicesStatusText" Grid.Row="1" Text="" FontSize="10"
                         Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"
                         HorizontalAlignment="Center"/>
              <!-- Compat shims for RefreshServicesPanelAsync until fully migrated -->
              <StackPanel IsVisible="False">
                <Ellipse x:Name="SvcHostDot"/><TextBlock x:Name="SvcHostStatus"/><TextBlock x:Name="SvcHostDetail"/>
                <Ellipse x:Name="SvcOllamaDot"/><TextBlock x:Name="SvcOllamaStatus"/><TextBlock x:Name="SvcOllamaDetail"/>
                <Ellipse x:Name="SvcCuaDot"/><TextBlock x:Name="SvcCuaStatus"/><TextBlock x:Name="SvcCuaDetail"/>
                <Ellipse x:Name="SvcUeDot"/><TextBlock x:Name="SvcUeStatus"/><TextBlock x:Name="SvcUeDetail"/>
                <Ellipse x:Name="SvcComfyDot"/><TextBlock x:Name="SvcComfyStatus"/><TextBlock x:Name="SvcComfyDetail"/>
                <ToggleButton x:Name="ServicesAlwaysOnTop"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="SettingsView" Margin="12" IsVisible="False">
      <Border Classes="metal glass" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Classes="frame-nav" Content="← BACK"
                    Click="OpenPresenceFromIdentity_Click" Margin="0,0,12,0"/>
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Classes="settings-tabs"
                    Background="Transparent" BorderThickness="0">
          <TabItem x:Name="IdentityTab" Header="Identity">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12" Spacing="6">
                <TextBlock Text="Identity" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           Text="Read-only portrait. Name is Host contact / local display text — no essay editor here."/>
                <TextBlock Text="Name" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,4"/>
                <TextBox x:Name="DisplayNameBox" Classes="input" IsReadOnly="True" MaxLength="64" Height="36"
                         VerticalContentAlignment="Center" Padding="8,0"/>
                <!-- Hidden shims: essay removed; charter/detail now structured -->
                <TextBox x:Name="IdentityDetailBox" IsVisible="False"/>
                <TextBox x:Name="IdentityCharterBox" IsVisible="False"/>

                <TextBlock Text="Charter anchors" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock x:Name="IdentityCharterKindsText" TextWrapping="Wrap" FontSize="12"
                           Text="Loading charter…"/>

                <TextBlock Text="Stats" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock x:Name="IdentityStatsText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Loading stats…"/>

                <TextBlock Text="Prompt mix" FontWeight="SemiBold" Margin="0,16,0,4"/>
                <TextBlock x:Name="IdentityPromptMixText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="—"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem x:Name="ToolsTab" Header="Tools &amp; Access">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="12">
                <TextBlock Text="Tools &amp; Access" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                           Text="Session gates on Host. Backends live on System. list-tools, system info, and her tasks/workflows stay always on."
                           Margin="0,0,0,16"/>
                <TextBlock Text="Desktop &amp; browser" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ToolsAllowDesktopCaptureCheck" Content="Allow desktop screenshots &amp; window list"
                          IsChecked="True" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowBrowserCaptureCheck" Content="Allow browser capture / health"
                          IsChecked="True" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowComputerControlCheck" Content="Allow computer control (click / type / key)"
                          IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsSoftCursorRestoreCheck" Content="Agent cursor — don't move my mouse"
                          IsChecked="True" Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsVmEmbedPaneCheck" Content="Embed VirtualBox (victoria-sandbox) in Her screen"
                          IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,16" Click="ToolsAccessToggle_Click"
                          ToolTip.Tip="SetParent the running VM window into Her screen. Keep victoria-sandbox visible (not minimized)."/>
                <TextBlock Text="Trading (MT4)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox x:Name="ToolsAllowMt4ReadCheck" Content="Allow MT4 read (status, symbols, positions)"
                          Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowMt4TradeCheck" Content="Allow MT4 trade / close / backtest"
                          Margin="0,0,0,16" Click="ToolsAccessToggle_Click"/>
                <TextBlock Text="Email permissions" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <CheckBox x:Name="ToolsAllowEmailReadCheck" Content="Allow email read / sort / mark"
                          Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowEmailSendCheck" Content="Allow email send / reply (still asks for confirmation)"
                          Margin="0,0,0,6" Click="ToolsAccessToggle_Click"/>
                <CheckBox x:Name="ToolsAllowEmailDeleteCheck" Content="Allow email delete (still asks for confirmation)"
                          Margin="0,0,0,8" Click="ToolsAccessToggle_Click"/>
                <Button Classes="primary" Content="Email setup…" HorizontalAlignment="Left"
                        Click="EmailSetup_Click" Margin="0,0,0,16"
                        ToolTip.Tip="One dialog — unlimited accounts, no three-role cap"/>
                <!-- Compat shims for removed Email-tab gate duplicates -->
                <CheckBox x:Name="EmailGateReadCheck" IsVisible="False" Click="EmailGateToggle_Click"/>
                <CheckBox x:Name="EmailGateSendCheck" IsVisible="False" Click="EmailGateToggle_Click"/>
                <CheckBox x:Name="EmailGateDeleteCheck" IsVisible="False" Click="EmailGateToggle_Click"/>
                <TextBlock x:Name="EmailGateStatusText" IsVisible="False"/>

                <TextBlock Text="Family switches" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                           Text="Host has not exposed these family gates yet — left off and disabled so Presence does not invent backend."/>
                <CheckBox x:Name="FamilyFilesOnPcCheck" Content="Files on this PC" IsEnabled="False" Margin="0,0,0,4"/>
                <CheckBox x:Name="FamilyGuestVmFilesShellCheck" Content="Guest VM files &amp; shell" IsEnabled="False" Margin="0,0,0,4"/>
                <CheckBox x:Name="FamilyBrowserDrivingCheck" Content="Browser driving (separate from capture)" IsEnabled="False" Margin="0,0,0,4"/>
                <CheckBox x:Name="FamilyBodyUnrealCheck" Content="Body / Unreal" IsEnabled="False" Margin="0,0,0,4"/>
                <CheckBox x:Name="FamilyChiefArchitectCheck" Content="Chief Architect" IsEnabled="False" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Content="Refresh" Click="ToolsAccessRefresh_Click"/>
                  <TextBlock x:Name="ToolsAccessStatusText" Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem x:Name="SystemTab" Header="System">
            <ScrollViewer x:Name="SystemScroll" VerticalScrollBarVisibility="Auto">
              <Grid Margin="12" ColumnDefinitions="*,16,*">
                <!-- Left: Host + token + mailboxes + VM -->
                <StackPanel>
                  <TextBlock Text="System" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <CheckBox x:Name="AutoStartStackCheck" Content="Auto-start Host + Ollama when Presence opens"
                            IsChecked="True" Margin="0,0,0,8" Click="AutoStartStackCheck_Click"/>
                  <!-- Repo path kept for code-behind resolve; not shown (PROP-17.4) -->
                  <TextBox x:Name="SoulCoreRepoRootBox" IsVisible="False"
                           LostFocus="SoulCoreRepoRootBox_LostFocus"/>
                  <TextBox x:Name="SystemEndpointBox" IsVisible="False"/>

                  <TextBlock Text="SoulCore Host" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <Button x:Name="HostStartButton" Classes="primary" Content="Start Host"
                            Click="HostStart_Click"/>
                    <Button x:Name="HostStopButton" Classes="ghost" Content="Stop Host"
                            Click="HostStop_Click"/>
                    <Button x:Name="HostRestartButton" Classes="ghost" Content="Restart Host"
                            Click="HostRestart_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="HostStackStatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap" Text="" Margin="0,0,0,12"/>

                  <TextBlock Text="Companion API token" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBox x:Name="CompanionTokenBox" Classes="input" PasswordChar="•"
                           Watermark="Paste token — leave blank to keep saved"
                           Padding="8" Margin="0,0,0,6"/>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <Button Classes="primary" Content="Save token" Click="CompanionTokenSave_Click"/>
                    <Button Classes="ghost" Content="Clear saved" Click="CompanionTokenClear_Click"/>
                    <Button Classes="ghost" Content="Reconnect WS" Click="CompanionTokenReconnect_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="CompanionTokenStatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                             Text="" Margin="0,0,0,12"/>

                  <TextBlock Text="Mailboxes" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock x:Name="SystemMailboxesText" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource MutedBrush}"
                             Text="None loaded — use Tools &amp; Access → Email setup."
                             Margin="0,0,0,12"/>

                  <TextBlock Text="Guest VM (victoria-sandbox)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"
                             Text="Operator buttons via VBoxManage. Presence does not auto-start the VM."/>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                    <Button Classes="primary" Content="Start" Click="VmStart_Click"/>
                    <Button Classes="ghost" Content="Save state" Click="VmSave_Click"/>
                    <Button Classes="ghost" Content="Power off" Click="VmPowerOff_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="VmStatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                             TextWrapping="Wrap" Text="" Margin="0,0,0,16"/>

                  <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <CheckBox x:Name="NotifEnabledCheckBox" Content="Sound when she messages (unfocused)"
                            IsChecked="True" Margin="0,0,0,6" Click="NotifEnabled_Click"/>
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Classes="ghost" Content="Browse…" Margin="8,0,0,0"
                            Click="NotifBrowse_Click"/>
                    <Button DockPanel.Dock="Right" Classes="ghost" Content="Clear" Margin="8,0,0,0"
                            Click="NotifClear_Click"/>
                    <TextBox x:Name="NotifSoundPathBox" Classes="input" IsReadOnly="True"
                             Text="(system beep)" Padding="8,0"/>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                    <Button Classes="ghost" Content="Test sound" Click="NotifTest_Click"/>
                    <TextBlock x:Name="NotifStatusText" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" FontSize="11"/>
                  </StackPanel>

                  <Border x:Name="SystemUpdatesBlock" Classes="carbon" Padding="10" Margin="0,0,0,12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Updates (PROP-16)" FontWeight="SemiBold"/>
                      <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                 Text="Git pull when behind, Host rebuild/restart, then Presence Velopack. Restart stack runs ALLSTOP → ALLSTART."/>
                      <TextBox x:Name="UpdateGitStatusBox" Classes="input" IsReadOnly="True" Text="—"
                               TextWrapping="Wrap" Padding="8"/>
                      <TextBox x:Name="UpdateVersionBox" Classes="input" IsReadOnly="True" Text="—"
                               Padding="8"/>
                      <TextBox x:Name="UpdateHostVersionBox" Classes="input" IsReadOnly="True" Text="—"
                               Padding="8"/>
                      <TextBox x:Name="UpdateFeedBox" Classes="input" IsReadOnly="True" Text="—"
                               TextWrapping="Wrap" Padding="8"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UpdateCheckButton" Classes="primary" Content="Check"
                                Click="UpdateCheck_Click"/>
                        <Button x:Name="UpdateNowButton" Classes="primary" Content="Update now"
                                Click="UpdateNow_Click"/>
                        <Button x:Name="UpdateApplyButton" Classes="ghost" Content="Download &amp; restart"
                                IsEnabled="False" Click="UpdateApply_Click"/>
                        <Button x:Name="RestartStackButton" Classes="ghost" Content="Restart stack"
                                Click="RestartStack_Click"/>
                      </StackPanel>
                      <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"
                                 Foreground="{DynamicResource MutedBrush}" Text=""/>
                    </StackPanel>
                  </Border>

                  <Button Classes="ghost" Content="Refresh" HorizontalAlignment="Left"
                          Click="RefreshSystem_Click"/>
                </StackPanel>

                <!-- Right (~half): health / versions -->
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Health &amp; versions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        Margin="0,0,0,12">
                    <TextBlock Text="Bind" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="SystemBindBox" Grid.Column="1" Classes="input" IsReadOnly="True" Text="—"
                             Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="1" Text="Port" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="SystemPortBox" Grid.Row="1" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="7700" Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Text="Inference" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="SystemInferenceBox" Grid.Row="2" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="3" Text="Memory path" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="SystemMemoryPathBox" Grid.Row="3" Grid.Column="1" Classes="input" IsReadOnly="True"
                             TextWrapping="Wrap" Text="—" Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="4" Text="Memory open" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="SystemMemoryOpenBox" Grid.Row="4" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="5" Text="SoulLoop" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="SystemSoulLoopBox" Grid.Row="5" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="6" Text="Desktop" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="ToolsDesktopBackendBox" Grid.Row="6" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="7" Text="Browser" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="ToolsBrowserBackendBox" Grid.Row="7" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="8" Text="MT4" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="ToolsMt4BackendBox" Grid.Row="8" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="6" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="9" Text="Versions" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,4"/>
                    <TextBox x:Name="SystemVersionsBox" Grid.Row="9" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="6" Margin="0,0,0,6"/>
                  </Grid>

                  <TextBlock Text="Voice (STT / TTS)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock x:Name="SystemVoiceHealthText" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource MutedBrush}" Text="—" Margin="0,0,0,8"/>
                  <Expander Header="Advanced voice URLs" IsExpanded="False">
                    <TextBlock x:Name="SystemVoiceUrlsText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" Text="—"/>
                  </Expander>

                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button Classes="ghost" Content="Tick SoulLoop" Click="SoulLoopTick_Click"/>
                    <Button Classes="ghost" Content="Reconnect WS" Click="SoulLoopRestart_Click"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        </Grid>
      </Border>
    </Grid>
      </DockPanel>

      <!-- PROP-12.1: frameless edge/corner resize (BeginResizeDrag). Z-order above content rim. -->
      <Border x:Name="ResizeWest" Width="6" HorizontalAlignment="Left" Background="Transparent"
              Cursor="SizeWestEast" PointerPressed="ResizeEdge_PointerPressed" Tag="West"/>
      <Border x:Name="ResizeEast" Width="6" HorizontalAlignment="Right" Background="Transparent"
              Cursor="SizeWestEast" PointerPressed="ResizeEdge_PointerPressed" Tag="East"/>
      <Border x:Name="ResizeNorth" Height="6" VerticalAlignment="Top" Background="Transparent"
              Cursor="SizeNorthSouth" PointerPressed="ResizeEdge_PointerPressed" Tag="North"/>
      <Border x:Name="ResizeSouth" Height="6" VerticalAlignment="Bottom" Background="Transparent"
              Cursor="SizeNorthSouth" PointerPressed="ResizeEdge_PointerPressed" Tag="South"/>
      <Border x:Name="ResizeNorthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent" Cursor="TopLeftCorner" PointerPressed="ResizeEdge_PointerPressed" Tag="NorthWest"/>
      <Border x:Name="ResizeNorthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="Transparent" Cursor="TopRightCorner" PointerPressed="ResizeEdge_PointerPressed" Tag="NorthEast"/>
      <Border x:Name="ResizeSouthWest" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="ResizeEdge_PointerPressed" Tag="SouthWest"/>
      <Border x:Name="ResizeSouthEast" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizeEdge_PointerPressed" Tag="SouthEast"/>
    </Grid>
  </Border>
  </Border>
</Window>
