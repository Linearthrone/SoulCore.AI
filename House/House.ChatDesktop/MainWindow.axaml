<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:House.ChatDesktop.Controls"
        xmlns:views="clr-namespace:House.ChatDesktop.Views"
        x:Class="House.ChatDesktop.MainWindow"
        Title="House Victoria — Presence"
        Height="996" Width="460"
        MinHeight="780" MinWidth="360"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        TransparencyLevelHint="Transparent,AcrylicBlur,Blur,None"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/soulcore.ico">
  <!-- PROP-22: frameless glass slab (19.5:9). Dull neon rim, near-black cool glass. -->
  <Border Classes="shell-bevel" Margin="4">
  <Border Classes="shell">
    <Grid>
      <Border Classes="shell-inner"/>
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Thin top drag strip: orb · title · min/max/close -->
        <Border x:Name="TitleDragRegion" Grid.Row="0" Padding="12,10,10,6"
                Background="Transparent" PointerPressed="TitleDragRegion_PointerPressed"
                DoubleTapped="TitleDragRegion_DoubleTapped">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="StatusOrbButton" Classes="round orb" Click="StatusOrb_Click"
                    ToolTip.Tip="System status">
              <Ellipse x:Name="StatusOrbLight" Width="14" Height="14" Fill="{DynamicResource OffDimBrush}"/>
            </Button>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock x:Name="IdentityNameText" Text="Victoria" FontWeight="SemiBold" FontSize="14"/>
                <Ellipse x:Name="MoodColorDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="MoodLabelText" Text="—" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="UpdateAvailableMark" Classes="chrome" Content="● update"
                        FontSize="10" Padding="7,1" IsVisible="False"
                        Click="UpdateAvailableMark_Click"
                        ToolTip.Tip="Update available — open Settings"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="ConnDot" Width="6" Height="6" Fill="{DynamicResource BadBrush}"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="PresenceStateText" Text="—" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="·" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                <TextBlock x:Name="ActivityText" Text="Nothing right now" FontSize="10" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" MaxWidth="190"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
              <Button Classes="window-chrome" Content="─" Click="Minimize_Click" ToolTip.Tip="Minimize"/>
              <Button x:Name="MaximizeButton" Classes="window-chrome" Content="□" Click="Maximize_Click"
                      ToolTip.Tip="Maximize"/>
              <Button Classes="window-chrome close" Content="✕" Click="Close_Click" ToolTip.Tip="Close"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Update toast -->
        <Border x:Name="UpdateToastBar" Grid.Row="1" IsVisible="False"
                Classes="card" Padding="12,8" Margin="12,0,12,6">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="ghost" Content="Dismiss" Margin="8,0,0,0"
                    Click="UpdateToastDismiss_Click"/>
            <Button x:Name="UpdateToastActionButton" DockPanel.Dock="Right" Classes="primary"
                    Content="Update" Margin="8,0,0,0" Click="UpdateApply_Click"/>
            <TextBlock x:Name="UpdateToastText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                       Text="Update available"/>
          </DockPanel>
        </Border>

        <!-- Main content host: one screen at a time. Overlays share the same cell. -->
        <Grid x:Name="ContentHost" Grid.Row="2" RowDefinitions="*,*,*" Margin="0,0,0,0">

          <!-- ═══ Chat (default) ═══ -->
          <Grid x:Name="ChatScreen" Grid.RowSpan="3" RowDefinitions="Auto,*,Auto" Margin="12,2,12,4">
            <Border x:Name="WhileYouWereGonePanel" Grid.Row="0" Classes="card" Margin="0,0,0,6" IsVisible="False">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Classes="chrome" Content="×" Padding="6,1"
                        VerticalAlignment="Top" Click="WhileYouWereGoneDismiss_Click"
                        ToolTip.Tip="Dismiss this strip"/>
                <StackPanel Spacing="3" Margin="0,0,8,0">
                  <TextBlock Text="While you were gone" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock x:Name="WhileYouWereGoneText" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource MutedBrush}" Text="Loading store…"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <ItemsControl x:Name="TranscriptList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Classes="msg-row">
                        <Border Classes="bubble" Classes.user="{Binding IsUser}">
                          <StackPanel>
                            <Image Source="{Binding Image}" IsVisible="{Binding HasImage}"
                                   MaxHeight="240" MaxWidth="300" Stretch="Uniform" Margin="0,0,0,6"/>
                            <SelectableTextBlock Text="{Binding Text}" IsVisible="{Binding HasText}"
                                                 TextWrapping="Wrap"
                                                 SelectionBrush="{DynamicResource AccentDimBrush}"
                                                 PointerReleased="MessageText_PointerReleased">
                              <SelectableTextBlock.ContextMenu>
                                <ContextMenu>
                                  <MenuItem Header="Quote selection" Click="QuoteSelection_Click"/>
                                  <MenuItem Header="Quote message" Click="QuoteMessage_Click"/>
                                </ContextMenu>
                              </SelectableTextBlock.ContextMenu>
                            </SelectableTextBlock>
                            <DockPanel Margin="0,6,0,0" LastChildFill="False">
                              <Button DockPanel.Dock="Right" Classes="chrome" Content="Quote"
                                      Padding="8,1" FontSize="10" Tag="{Binding}"
                                      Click="QuoteMessageButton_Click"
                                      IsVisible="{Binding HasText}"/>
                              <TextBlock Text="{Binding DisplayTime}" FontSize="10"
                                         Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="TypingIndicator" Orientation="Horizontal" Spacing="6"
                            Margin="12,6,0,8" IsVisible="False">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0.9"/>
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0.6"/>
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Opacity="0.35"/>
                  <TextBlock x:Name="TypingLabel" Text="Thinking" FontSize="12"
                             Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- Composer: Attach · PTT · growing input · round Send -->
            <Border Grid.Row="2" Classes="card" Padding="8" CornerRadius="26" Margin="0,6,0,0">
              <StackPanel Spacing="6">
                <Border x:Name="QuoteChip" Classes="carbon" Padding="10,6" IsVisible="False">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="chrome" Content="×" Padding="6,1"
                            Click="ClearQuote_Click" ToolTip.Tip="Clear quote"/>
                    <StackPanel>
                      <TextBlock Text="Replying to excerpt" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock x:Name="QuoteChipText" FontSize="11" TextWrapping="Wrap" MaxHeight="64"
                                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border x:Name="PendingImageChip" Classes="carbon" Padding="8,4" IsVisible="False"
                        HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="PendingImageLabel" Text="image" FontSize="11" VerticalAlignment="Center"/>
                    <Button Classes="chrome" Content="×" Padding="6,1" Click="ClearPendingImage_Click"/>
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                  <Button x:Name="AttachButton" Grid.Column="0" Classes="round" Width="34" Height="34"
                          VerticalAlignment="Bottom" Click="AttachImage_Click"
                          ToolTip.Tip="Attach image (MMS outbound)">
                    <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconClip}"
                          Fill="{Binding $parent[Button].Foreground}"/>
                  </Button>
                  <Button x:Name="PttButton" Grid.Column="1" Classes="round" Width="34" Height="34"
                          VerticalAlignment="Bottom"
                          ToolTip.Tip="Hold to talk — mic → Host Soniox STT">
                    <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconMic}"
                          Fill="{Binding $parent[Button].Foreground}"/>
                  </Button>
                  <TextBox x:Name="ChatInput" Grid.Column="2" Classes="composer"
                           VerticalContentAlignment="Center"
                           Watermark="Message Victoria…"
                           TextChanged="ChatInput_TextChanged"/>
                  <Button x:Name="SendButton" Grid.Column="3" Classes="round send" Width="38" Height="38"
                          VerticalAlignment="Bottom" Click="Send_Click" ToolTip.Tip="Send (Enter)">
                    <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource IconSend}"
                          Fill="{Binding $parent[Button].Foreground}"/>
                  </Button>
                </Grid>
                <DockPanel LastChildFill="False">
                  <TextBlock x:Name="PttHintText" DockPanel.Dock="Left" Text="" FontSize="10"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                  <TextBlock x:Name="VoiceHealthCompactText" DockPanel.Dock="Right" Text="" FontSize="10"
                             Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ═══ In-glass screens ═══ -->
          <Border x:Name="JournalScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="chat" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <TextBlock Text="Her journal" Classes="screen-title" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <views:JournalView x:Name="JournalPane" Grid.Row="1"/>
            </Grid>
          </Border>

          <Border x:Name="ActivitiesScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="chat" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <TextBlock Text="Activities" Classes="screen-title" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <views:ActivitiesView x:Name="ActivitiesPane" Grid.Row="1"/>
            </Grid>
          </Border>

          <Border x:Name="ResearchScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="chat" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <TextBlock Text="Research" Classes="screen-title" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <views:ResearchView x:Name="ResearchPane" Grid.Row="1"/>
            </Grid>
          </Border>

          <!-- Bond: counters, pending band-cross, soak, ledger (+ the rest of the identity read-out) -->
          <Border x:Name="BondScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="chat" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <TextBlock Text="Bond" Classes="screen-title" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Margin="0,0,6,0">
                  <TextBlock Text="Bond counters" Classes="section"/>
                  <TextBlock x:Name="IdentityBondCountersText" TextWrapping="Wrap" FontSize="12"
                             Text="Loading bond counters…"/>
                  <TextBlock Text="Pending band-cross" Classes="section"/>
                  <TextBlock x:Name="IdentityPendingBandCrossText" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource MutedBrush}" Text="Loading pending…"/>
                  <ItemsControl x:Name="IdentityPendingBandCrossList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card" Margin="0,3">
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Line}" FontSize="11" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Button Classes="primary" Content="Confirm" FontSize="11" Padding="12,4"
                                      Click="IdentityPendingConfirm_Click"
                                      ToolTip.Tip="Apply this band-cross on Host."/>
                              <Button Classes="ghost" Content="Dismiss" FontSize="11" Padding="12,4"
                                      Click="IdentityPendingDismiss_Click"
                                      ToolTip.Tip="Reject this band-cross on Host."/>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Soak" Classes="section"/>
                  <TextBlock x:Name="IdentitySoakText" TextWrapping="Wrap" FontSize="12" Text="Loading soak…"/>
                  <TextBlock Text="Growth ledger" Classes="section"/>
                  <TextBlock x:Name="IdentityGrowthLedgerText" TextWrapping="Wrap" FontSize="12"
                             Text="Loading growth ledger…"/>
                  <Expander Header="More identity detail" Margin="0,10,0,0">
                    <StackPanel Spacing="4" Margin="0,6,0,0">
                      <TextBlock Text="Charter anchors" Classes="section"/>
                      <TextBlock x:Name="IdentityCharterKindsText" TextWrapping="Wrap" FontSize="12"
                                 Text="Loading charter…"/>
                      <TextBlock Text="Resting traits" Classes="section"/>
                      <TextBlock x:Name="IdentityRestingTraitsText" TextWrapping="Wrap" FontSize="12"
                                 Text="Loading resting traits…"/>
                      <TextBlock Text="Context traits" Classes="section"/>
                      <TextBlock x:Name="IdentityContextTraitsText" TextWrapping="Wrap" FontSize="12"
                                 Text="Loading context traits…"/>
                      <TextBlock Text="Growth traits" Classes="section"/>
                      <TextBlock x:Name="IdentityGrowthTraitsText" TextWrapping="Wrap" FontSize="12"
                                 Text="Loading growth traits…"/>
                      <TextBlock Text="Stats" Classes="section"/>
                      <TextBlock x:Name="IdentityStatsText" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource MutedBrush}" Text="Loading stats…"/>
                      <TextBlock Text="Prompt mix" Classes="section"/>
                      <TextBlock x:Name="IdentityPromptMixText" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource MutedBrush}" Text="—"/>
                    </StackPanel>
                  </Expander>
                  <!-- Compat shims: code-behind still fills these. -->
                  <StackPanel IsVisible="False">
                    <TextBox x:Name="DisplayNameBox"/>
                    <TextBox x:Name="IdentityDetailBox"/>
                    <TextBox x:Name="IdentityCharterBox"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Tasks: Yours (operator work items) + Hers (Victoria's /tasks ledger) -->
          <Border x:Name="TasksScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="chat" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button DockPanel.Dock="Right" Classes="primary" Content="Create New" Padding="14,6"
                        Click="WorkCreateNew_Click"/>
                <TextBlock Text="Tasks" Classes="screen-title" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Margin="0,0,6,0">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="chrome" Content="Refresh" Click="WorkRefresh_Click"/>
                    <TextBlock Text="Yours" Classes="section" Margin="0,4,0,4"/>
                  </DockPanel>
                  <TextBlock x:Name="OperatorWorkStatusText" Classes="muted" Text="Loading…"/>
                  <ItemsControl x:Name="OperatorWorkList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card" Margin="0,3">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              </StackPanel>
                              <TextBlock Text="{Binding MetaLine}" FontSize="10"
                                         Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                         Foreground="{DynamicResource MutedBrush}" MaxHeight="52"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="chrome" Content="Delete" VerticalAlignment="Top"
                                    Click="WorkDelete_Click" ToolTip.Tip="Remove this item."/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Classes="chrome" Content="Add" Click="BandTaskAdd_Click"
                            ToolTip.Tip="Add a task to her ledger (starts as todo)."/>
                    <TextBlock Text="Hers" Classes="section" Margin="0,4,0,4"/>
                  </DockPanel>
                  <TextBlock x:Name="BandTasksText" Classes="muted" Text="No tasks."/>
                  <ItemsControl x:Name="BandTaskList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="card" Margin="0,3">
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Line}" FontSize="11" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Button Classes="chrome" Content="Suspend" FontSize="10" Padding="8,2"
                                      Click="BandTaskSuspend_Click" ToolTip.Tip="Stop auto-start; keep on the list."/>
                              <Button Classes="chrome" Content="Release" FontSize="10" Padding="8,2"
                                      Click="BandTaskRelease_Click" ToolTip.Tip="Release parked/suspended to todo."/>
                              <Button Classes="chrome" Content="Delete" FontSize="10" Padding="8,2"
                                      Click="BandTaskDelete_Click" ToolTip.Tip="Remove this task permanently."/>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Work item form (task | project) -->
          <Border x:Name="WorkItemFormScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="tasks" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <ToggleSwitch x:Name="WorkKindProjectToggle" DockPanel.Dock="Right" OnContent="Project"
                              OffContent="Task" IsCheckedChanged="WorkKindToggle_Changed"/>
                <TextBlock Text="New" Classes="screen-title" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Margin="0,0,6,0">
                  <TextBlock Text="Title" Classes="section" Margin="0,0,0,2"/>
                  <TextBox x:Name="WorkTitleBox" Classes="input" MaxLength="200" Padding="10,8"/>
                  <TextBlock Text="Description" Classes="section"/>
                  <TextBox x:Name="WorkDescriptionBox" Classes="input" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="60" MaxHeight="120" Padding="10,8"/>
                  <TextBlock Text="Details" Classes="section"/>
                  <TextBox x:Name="WorkDetailsBox" Classes="input" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="60" MaxHeight="120" Padding="10,8"/>
                  <TextBlock Text="Deadline (optional)" Classes="section"/>
                  <Grid ColumnDefinitions="*,8,90">
                    <CalendarDatePicker x:Name="WorkDeadlineDate" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="WorkDeadlineTime" Grid.Column="2" Classes="input" Text="17:00"
                             Watermark="HH:mm" Padding="8,8"/>
                  </Grid>
                  <TextBlock Text="Priority (1–5)" Classes="section"/>
                  <NumericUpDown x:Name="WorkPriorityBox" Minimum="1" Maximum="5" Value="3" Increment="1"
                                 FormatString="0" HorizontalAlignment="Left" Width="140"/>
                  <CheckBox x:Name="WorkNoCheckinCheck" Content="No check-in (start to finish)" Margin="0,8,0,0"/>
                  <CheckBox x:Name="WorkNeedsPermsCheck" Content="Needs extra permissions"/>
                  <CheckBox x:Name="WorkOutsideCollabCheck" Content="Outside collaboration"/>
                  <TextBlock Text="Phase checkpoints — project only (one per line)" Classes="section"/>
                  <TextBox x:Name="WorkPhasesBox" Classes="input" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="60" MaxHeight="120" Padding="10,8"/>
                  <TextBlock Text="Deliverables — project only (one per line)" Classes="section"/>
                  <TextBox x:Name="WorkDeliverablesBox" Classes="input" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="60" MaxHeight="120" Padding="10,8"/>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                <TextBlock x:Name="WorkFormStatusText" Classes="muted" Text=""/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button Classes="ghost" Content="Cancel" Tag="tasks" Click="Back_Click"/>
                  <Button x:Name="WorkSaveButton" Classes="primary" Content="Create" Click="WorkSave_Click"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Calendar: Mon–Sun week -->
          <Border x:Name="CalendarScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="chat" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button DockPanel.Dock="Right" Classes="chrome" Content="Refresh" Click="CalendarRefresh_Click"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Calendar" Classes="screen-title"/>
                  <TextBlock x:Name="CalendarWeekText" Classes="muted" Text=""/>
                </StackPanel>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CalendarDaysPanel" Spacing="6" Margin="0,0,6,0"/>
              </ScrollViewer>
              <Border Grid.Row="2" Classes="card" Margin="0,8,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="Add reminder" Classes="section" Margin="0"/>
                  <TextBox x:Name="AgendaTitleBox" Classes="input" Watermark="Title" MaxLength="200" Padding="10,8"/>
                  <Grid ColumnDefinitions="*,8,90">
                    <ComboBox x:Name="AgendaWeekdayCombo" HorizontalAlignment="Stretch"/>
                    <TextBox x:Name="AgendaTimeBox" Grid.Column="2" Classes="input" Text="09:00" Watermark="HH:mm"
                             Padding="8,8"/>
                  </Grid>
                  <TextBox x:Name="AgendaNotesBox" Classes="input" Watermark="Notes (optional)" Padding="10,8"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="primary" Content="Add" Click="AgendaAdd_Click"/>
                    <TextBlock x:Name="CalendarStatusText" Classes="muted" Text="" VerticalAlignment="Center"/>
                  </DockPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Settings -->
          <Border x:Name="SettingsScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="chat" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <TextBlock Text="Settings" Classes="screen-title" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Margin="0,0,6,0">

                  <TextBlock Text="Notification sound" Classes="section" Margin="0,0,0,2"/>
                  <CheckBox x:Name="NotifEnabledCheckBox" Content="Sound when she messages (unfocused)"
                            IsChecked="True" Click="NotifEnabled_Click"/>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="ghost" Content="Browse…" Margin="6,0,0,0"
                            Click="NotifBrowse_Click"/>
                    <Button DockPanel.Dock="Right" Classes="ghost" Content="Clear" Margin="6,0,0,0"
                            Click="NotifClear_Click"/>
                    <TextBox x:Name="NotifSoundPathBox" Classes="input" IsReadOnly="True"
                             Text="(system beep)" Padding="8,6"/>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="ghost" Content="Test sound" Click="NotifTest_Click"/>
                    <TextBlock x:Name="NotifStatusText" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" FontSize="11"/>
                  </StackPanel>

                  <TextBlock Text="Updates" Classes="section"/>
                  <Border x:Name="SystemUpdatesBlock" Classes="card">
                    <StackPanel Spacing="6">
                      <TextBox x:Name="UpdateGitStatusBox" Classes="input" IsReadOnly="True" Text="—"
                               TextWrapping="Wrap" Padding="8,6"/>
                      <TextBox x:Name="UpdateVersionBox" Classes="input" IsReadOnly="True" Text="—" Padding="8,6"/>
                      <TextBox x:Name="UpdateHostVersionBox" Classes="input" IsReadOnly="True" Text="—" Padding="8,6"/>
                      <TextBox x:Name="UpdateFeedBox" Classes="input" IsReadOnly="True" Text="—"
                               TextWrapping="Wrap" Padding="8,6"/>
                      <WrapPanel>
                        <Button x:Name="UpdateCheckButton" Classes="primary" Content="Check updates"
                                Margin="0,0,6,6" Click="UpdateCheck_Click"/>
                        <Button x:Name="UpdateNowButton" Classes="primary" Content="Update now"
                                Margin="0,0,6,6" Click="UpdateNow_Click"/>
                        <Button x:Name="UpdateApplyButton" Classes="ghost" Content="Download &amp; restart"
                                Margin="0,0,6,6" IsEnabled="False" Click="UpdateApply_Click"/>
                        <Button x:Name="RestartStackButton" Classes="ghost" Content="Restart stack"
                                Margin="0,0,6,6" Click="RestartStack_Click"/>
                      </WrapPanel>
                      <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{DynamicResource MutedBrush}" Text=""/>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="Keys — saved values are never shown" Classes="section"/>
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <TextBlock Text="Companion" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompanionTokenStatusText" DockPanel.Dock="Right" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" Text=""/>
                      </DockPanel>
                      <TextBox x:Name="CompanionTokenBox" Classes="input" PasswordChar="•"
                               Watermark="Paste to replace" Padding="8,6"/>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary" Content="Save" Click="CompanionTokenSave_Click"/>
                        <Button Classes="ghost" Content="Clear" Click="CompanionTokenClear_Click"/>
                        <Button Classes="ghost" Content="Reconnect" Click="CompanionTokenReconnect_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <TextBlock Text="Ollama" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OllamaKeyStatusText" DockPanel.Dock="Right" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" Text=""/>
                      </DockPanel>
                      <TextBox x:Name="OllamaKeyBox" Classes="input" PasswordChar="•"
                               Watermark="Paste to replace" Padding="8,6"/>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary" Content="Save" Tag="SOULCORE_OLLAMA_API_KEY" Click="SecretSave_Click"/>
                        <Button Classes="ghost" Content="Clear" Tag="SOULCORE_OLLAMA_API_KEY" Click="SecretClear_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <TextBlock Text="Soniox" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SonioxKeyStatusText" DockPanel.Dock="Right" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" Text=""/>
                      </DockPanel>
                      <TextBox x:Name="SonioxKeyBox" Classes="input" PasswordChar="•"
                               Watermark="Paste to replace" Padding="8,6"/>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary" Content="Save" Tag="SONIOX_API_KEY" Click="SecretSave_Click"/>
                        <Button Classes="ghost" Content="Clear" Tag="SONIOX_API_KEY" Click="SecretClear_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <DockPanel>
                        <TextBlock Text="Synthetic" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SyntheticKeyStatusText" DockPanel.Dock="Right" FontSize="11"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" Text=""/>
                      </DockPanel>
                      <TextBox x:Name="SyntheticKeyBox" Classes="input" PasswordChar="•"
                               Watermark="Paste to replace" Padding="8,6"/>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="primary" Content="Save" Tag="SOULCORE_SYNTHETIC_API_KEY" Click="SecretSave_Click"/>
                        <Button Classes="ghost" Content="Clear" Tag="SOULCORE_SYNTHETIC_API_KEY" Click="SecretClear_Click"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="SecretStatusText" Classes="muted" Text=""/>

                  <TextBlock Text="SoulCore Host" Classes="section"/>
                  <CheckBox x:Name="AutoStartStackCheck" Content="Auto-start Host + Ollama when Presence opens"
                            IsChecked="True" Click="AutoStartStackCheck_Click"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="HostStartButton" Classes="primary" Content="Start" Click="HostStart_Click"/>
                    <Button x:Name="HostStopButton" Classes="ghost" Content="Stop" Click="HostStop_Click"/>
                    <Button x:Name="HostRestartButton" Classes="ghost" Content="Restart" Click="HostRestart_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="HostStackStatusText" Classes="muted" Text=""/>
                  <TextBlock x:Name="ServicesStatusText" Classes="muted" Text=""/>

                  <TextBlock Text="Guest VM (KsDevice)" Classes="section"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="primary" Content="Start" Click="VmStart_Click"/>
                    <Button Classes="ghost" Content="Save state" Click="VmSave_Click"/>
                    <Button Classes="ghost" Content="Power off" Click="VmPowerOff_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="VmStatusText" Classes="muted" Text=""/>
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="VM drawer side" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                    <ComboBox x:Name="VmDrawerSideCombo" HorizontalAlignment="Left" MinWidth="110"
                              SelectionChanged="VmDrawerSideCombo_SelectionChanged">
                      <ComboBoxItem Content="Left" Tag="left"/>
                      <ComboBoxItem Content="Right" Tag="right"/>
                    </ComboBox>
                  </DockPanel>

                  <TextBlock Text="Mailboxes" Classes="section"/>
                  <TextBlock x:Name="SystemMailboxesText" Classes="muted" Text="None loaded."/>

                  <Expander Header="Access tools" Margin="0,10,0,0">
                    <StackPanel Spacing="3" Margin="0,6,0,0">
                      <TextBlock Classes="muted"
                                 Text="Session gates on Host. list-tools, system info, and her tasks stay always on."/>
                      <CheckBox x:Name="ToolsAllowDesktopCaptureCheck" Content="Allow desktop screenshots &amp; window list"
                                IsChecked="True" Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsAllowBrowserCaptureCheck" Content="Allow browser capture / health"
                                IsChecked="True" Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsAllowComputerControlCheck" Content="Allow computer control (click / type / key)"
                                IsChecked="True" FontWeight="SemiBold" Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsSoftCursorRestoreCheck" Content="Agent cursor — don't move my mouse"
                                IsChecked="True" Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsVmEmbedPaneCheck" Content="Embed VirtualBox (KsDevice) in Her screen"
                                IsChecked="True" FontWeight="SemiBold" Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsAllowMt4ReadCheck" Content="Allow MT4 read (status, symbols, positions)"
                                Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsAllowMt4TradeCheck" Content="Allow MT4 trade / close / backtest"
                                Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsAllowEmailReadCheck" Content="Allow email read / sort / mark"
                                Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsAllowEmailSendCheck" Content="Allow email send / reply (still asks)"
                                Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsAllowEmailDeleteCheck" Content="Allow email delete (still asks)"
                                Click="ToolsAccessToggle_Click"/>
                      <CheckBox x:Name="ToolsAllowGuestSudoCheck" Content="Allow guest sudo (NOPASSWD in VM)"
                                Click="ToolsAccessToggle_Click"/>
                      <!-- Compat shims for the removed Email-tab gate duplicates -->
                      <CheckBox x:Name="EmailGateReadCheck" IsVisible="False" Click="EmailGateToggle_Click"/>
                      <CheckBox x:Name="EmailGateSendCheck" IsVisible="False" Click="EmailGateToggle_Click"/>
                      <CheckBox x:Name="EmailGateDeleteCheck" IsVisible="False" Click="EmailGateToggle_Click"/>
                      <TextBlock x:Name="EmailGateStatusText" IsVisible="False"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Refresh" Click="ToolsAccessRefresh_Click"/>
                        <TextBlock x:Name="ToolsAccessStatusText" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" FontSize="11"/>
                      </StackPanel>
                    </StackPanel>
                  </Expander>

                  <TextBlock Text="Logs &amp; advanced" Classes="section"/>
                  <WrapPanel>
                    <Button Classes="ghost" Content="Performance log" Margin="0,0,6,6" Click="PerformanceLog_Click"/>
                    <Button Classes="ghost" Content="System log" Margin="0,0,6,6" Click="SystemLog_Click"/>
                    <Button Classes="ghost" Content="Advanced" Margin="0,0,6,6" Click="Advanced_Click"/>
                  </WrapPanel>

                  <!-- Hidden: repo path kept for code-behind resolve; endpoint mirrored in Advanced. -->
                  <TextBox x:Name="SoulCoreRepoRootBox" IsVisible="False"
                           LostFocus="SoulCoreRepoRootBox_LostFocus"/>
                  <TextBox x:Name="SystemEndpointBox" IsVisible="False"/>
                  <TextBlock x:Name="ConnStatusText" Text="" IsVisible="False"/>
                  <Button x:Name="NavUpdate" IsVisible="False" Click="UpdateNow_Click"/>
                  <Button x:Name="NavRestartStack" IsVisible="False" Click="RestartStack_Click"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Advanced -->
          <Border x:Name="AdvancedSettingsScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4"
                  IsVisible="False">
            <Grid RowDefinitions="Auto,*">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="settings" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <TextBlock Text="Advanced" Classes="screen-title" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </DockPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Margin="0,0,6,0">
                  <TextBlock Text="Host network" Classes="section" Margin="0,0,0,2"/>
                  <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Text="Bind" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SystemBindBox" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="127.0.0.1" Padding="8,6"
                             ToolTip.Tip="Fixed. The Host only ever listens on loopback."/>
                    <TextBlock Grid.Row="1" Text="Port" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="SystemPortBox" Grid.Row="1" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="7710" Padding="8,6"/>
                    <TextBlock Grid.Row="2" Text="New port" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <DockPanel Grid.Row="2" Grid.Column="1">
                      <Button DockPanel.Dock="Right" Classes="ghost" Content="Save port…" Margin="6,0,0,0"
                              Click="AdvancedPortSave_Click"/>
                      <TextBox x:Name="AdvancedPortBox" Classes="input" Watermark="1024–65535" Padding="8,6"/>
                    </DockPanel>
                  </Grid>
                  <TextBlock x:Name="AdvancedPortStatusText" Classes="muted"
                             Text="Changes only where this app looks for the Host. It does not move the Host's own port."/>

                  <TextBlock Text="Mailbox" Classes="section"/>
                  <Button Classes="primary" Content="Mailbox form…" HorizontalAlignment="Left"
                          Click="EmailSetup_Click"
                          ToolTip.Tip="Add or change a mailbox — asks you to confirm the account first"/>

                  <TextBlock Text="Health &amp; versions" Classes="section"/>
                  <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Text="Endpoint" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EndpointText" Grid.Column="1" Text="127.0.0.1:7710" FontSize="12"/>
                    <TextBlock Grid.Row="1" Text="Model" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SystemInferenceBox" Grid.Row="1" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="8,6"/>
                    <TextBlock Grid.Row="2" Text="Memory path" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SystemMemoryPathBox" Grid.Row="2" Grid.Column="1" Classes="input" IsReadOnly="True"
                             TextWrapping="Wrap" Text="—" Padding="8,6"/>
                    <TextBlock Grid.Row="3" Text="Memory open" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SystemMemoryOpenBox" Grid.Row="3" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="8,6"/>
                    <TextBlock Grid.Row="4" Text="SoulLoop" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SystemSoulLoopBox" Grid.Row="4" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="8,6"/>
                    <TextBlock Grid.Row="5" Text="Desktop" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ToolsDesktopBackendBox" Grid.Row="5" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="8,6"/>
                    <TextBlock Grid.Row="6" Text="Browser" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ToolsBrowserBackendBox" Grid.Row="6" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="8,6"/>
                    <TextBlock Grid.Row="7" Text="MT4" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ToolsMt4BackendBox" Grid.Row="7" Grid.Column="1" Classes="input" IsReadOnly="True"
                             Text="—" Padding="8,6"/>
                  </Grid>
                  <TextBlock Text="Versions" Classes="section"/>
                  <TextBox x:Name="SystemVersionsBox" Classes="input" IsReadOnly="True" Text="—" Padding="8,6"/>
                  <TextBlock x:Name="BuildVersionsText" Text="" FontSize="10"
                             Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>

                  <TextBlock Text="Voice (STT / TTS)" Classes="section"/>
                  <TextBlock x:Name="SystemVoiceHealthText" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource MutedBrush}" Text="—"/>
                  <Expander Header="Voice URLs">
                    <TextBlock x:Name="SystemVoiceUrlsText" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" Text="—"/>
                  </Expander>

                  <WrapPanel Margin="0,10,0,0">
                    <Button Classes="ghost" Content="Refresh" Margin="0,0,6,6" Click="RefreshSystem_Click"/>
                    <Button Classes="ghost" Content="Tick SoulLoop" Margin="0,0,6,6" Click="SoulLoopTick_Click"/>
                    <Button Classes="ghost" Content="Reconnect WS" Margin="0,0,6,6" Click="SoulLoopRestart_Click"/>
                  </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Performance / system log -->
          <Border x:Name="LogScreen" Grid.RowSpan="3" Classes="panel" Margin="10,2,10,4" IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto">
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Classes="round" Width="34" Height="34" Tag="settings" Click="Back_Click"
                        ToolTip.Tip="Back">
                  <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconBack}"
                        Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button DockPanel.Dock="Right" Classes="chrome" Content="Refresh" Click="LogRefresh_Click"/>
                <TextBlock x:Name="LogTitleText" Text="Performance log" Classes="screen-title" Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <TextBox x:Name="LogBodyBox" Grid.Row="1" Classes="input" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="NoWrap" FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11"
                       Padding="8"/>
              <DockPanel Grid.Row="2" Margin="0,8,0,0">
                <Button x:Name="LogClearButton" DockPanel.Dock="Right" Classes="ghost" Content="Clear"
                        Click="LogClear_Click"/>
                <TextBlock x:Name="LogStatusText" Classes="muted" Text="" VerticalAlignment="Center"/>
              </DockPanel>
            </Grid>
          </Border>

          <!-- ═══ Call overlay: full glass while connecting, top third once connected ═══ -->
          <Border x:Name="CallOverlay" Grid.RowSpan="3" IsVisible="False" ZIndex="20"
                  Background="{DynamicResource GlassScrimBrush}" ClipToBounds="True" Margin="6,0,6,0"
                  CornerRadius="24">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16,12">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="chrome" Content="End call" Click="CallEnd_Click"/>
                <TextBlock Text="Call · Victoria" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
              </DockPanel>
              <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="190" Margin="0,6">
                <controls:CallSpeakingSphere x:Name="CallSphere"/>
              </Viewbox>
              <StackPanel Grid.Row="2" Spacing="4">
                <TextBlock x:Name="CallStatusText" Text="Listening…" FontSize="12"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="CallTranscriptPreview" Text="" FontSize="12" TextWrapping="Wrap"
                           MaxHeight="48" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ═══ Victoria drawer (bottom-left) ═══ -->
          <Border x:Name="VictoriaDrawerScrim" Grid.RowSpan="3" IsVisible="False" ZIndex="28"
                  Background="#33000000" PointerPressed="VictoriaDrawerScrim_PointerPressed"/>
          <Border x:Name="VictoriaDrawer" Grid.RowSpan="3" IsVisible="False" ZIndex="30"
                  Classes="panel" Width="340" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#F5111821"
                  Margin="12,0,0,6" MaxHeight="620" BoxShadow="0 12 32 0 #AA000000">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="6" Margin="0,0,4,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Button x:Name="PortraitButton" Classes="round" Width="76" Height="76" Padding="0"
                          Click="Portrait_Click" ToolTip.Tip="Open portrait card">
                    <Image Source="avares://House.ChatDesktop/Assets/house-victoria.png" Width="70" Height="70"
                           Stretch="UniformToFill">
                      <Image.Clip>
                        <EllipseGeometry Rect="0,0,70,70"/>
                      </Image.Clip>
                    </Image>
                  </Button>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Doing now" Classes="section" Margin="0"/>
                    <TextBlock x:Name="DoingNowText" Text="Nothing right now" TextWrapping="Wrap" FontSize="13"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Last activity" Classes="section"/>
                <TextBlock x:Name="LastActivityText" Text="—" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"/>
                <Button x:Name="OpenJournalLink" Classes="link" Content="Open journal entry →" IsVisible="False"
                        Click="OpenJournalLink_Click"/>
                <TextBlock x:Name="BandOnHerMindText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                           Foreground="{DynamicResource MutedBrush}" Text="On her mind — quiet between talks"/>
                <TextBlock x:Name="BandHonestyText" TextWrapping="Wrap" FontSize="10"
                           Foreground="{DynamicResource MutedBrush}" Text=""/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="chrome" Content="Correct mood…" FontSize="10"
                          Padding="8,2" Click="CorrectEmotion_Click"/>
                  <TextBlock x:Name="BandMoodText" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="Mood — —"/>
                </DockPanel>

                <Border x:Name="EmotionCorrectPanel" IsVisible="False" Classes="card">
                  <StackPanel>
                    <TextBlock Text="Correct mood" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid ColumnDefinitions="76,*,40" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                      <TextBlock Text="valence" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                      <Slider x:Name="CorrectValenceSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" Margin="0,2"/>
                      <TextBlock Grid.Column="2" Text="{Binding #CorrectValenceSlider.Value, StringFormat='{}{0:0.0}'}"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                      <TextBlock Grid.Row="1" Text="arousal" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                      <Slider x:Name="CorrectArousalSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Margin="0,2"/>
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding #CorrectArousalSlider.Value, StringFormat='{}{0:0.0}'}"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                      <TextBlock Grid.Row="2" Text="dominance" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                      <Slider x:Name="CorrectDominanceSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Margin="0,2"/>
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding #CorrectDominanceSlider.Value, StringFormat='{}{0:0.0}'}"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                      <TextBlock Grid.Row="3" Text="focus" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                      <Slider x:Name="CorrectFocusSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5" Margin="0,2"/>
                      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding #CorrectFocusSlider.Value, StringFormat='{}{0:0.0}'}"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
                    </Grid>
                    <TextBox x:Name="CorrectNoteBox" Classes="input" MaxLength="200" Padding="10,6"
                             Margin="0,0,0,8" Watermark="short note"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                      <Button Classes="ghost" Content="Cancel" Click="CorrectEmotionCancel_Click"/>
                      <Button Classes="primary" Content="Save" Click="CorrectEmotionSave_Click"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Text="Open" Classes="section"/>
                <UniformGrid Columns="2">
                  <Button Classes="nav-tile" Content="Journal" Tag="journal" Click="DrawerNav_Click" Margin="0,0,4,4"/>
                  <Button Classes="nav-tile" Content="Activities" Tag="activities" Click="DrawerNav_Click" Margin="4,0,0,4"/>
                  <Button Classes="nav-tile" Content="Research" Tag="research" Click="DrawerNav_Click" Margin="0,0,4,4"/>
                  <Button Classes="nav-tile" Content="Bond" Tag="bond" Click="DrawerNav_Click" Margin="4,0,0,4"/>
                  <Button Classes="nav-tile" Content="Tasks" Tag="tasks" Click="DrawerNav_Click" Margin="0,0,4,0"/>
                  <Button Classes="nav-tile" Content="Calendar" Tag="calendar" Click="DrawerNav_Click" Margin="4,0,0,0"/>
                </UniformGrid>
                <!-- Compat shim: BandDoingText was the old activity band line. -->
                <TextBlock x:Name="BandDoingText" IsVisible="False"/>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- ═══ Portrait card ═══ -->
          <Border x:Name="PortraitScrim" Grid.RowSpan="3" IsVisible="False" ZIndex="38"
                  Background="#99000000" PointerPressed="PortraitScrim_PointerPressed"/>
          <Border x:Name="PortraitCard" Grid.RowSpan="3" IsVisible="False" ZIndex="40"
                  Classes="panel" Width="360" MaxHeight="660" Background="#F5111821"
                  HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 40 0 #CC000000">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="8" Margin="0,0,4,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="round" Width="30" Height="30" Click="PortraitClose_Click"
                          ToolTip.Tip="Close">
                    <Path Width="11" Height="11" Stretch="Uniform" Data="{StaticResource IconClose}"
                          Fill="{Binding $parent[Button].Foreground}"/>
                  </Button>
                  <TextBlock x:Name="PortraitNameText" Text="Victoria" Classes="screen-title" VerticalAlignment="Center"/>
                </DockPanel>
                <Border CornerRadius="18" ClipToBounds="True" HorizontalAlignment="Center">
                  <Image Source="avares://House.ChatDesktop/Assets/house-victoria.png" Width="220" Height="220"
                         Stretch="UniformToFill"/>
                </Border>
                <TextBlock x:Name="PortraitSynopsisText" Text="Loading charter…" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="Model" Classes="section"/>
                <ComboBox x:Name="PortraitModelCombo" HorizontalAlignment="Stretch"/>
                <DockPanel>
                  <Button x:Name="PortraitApplyButton" DockPanel.Dock="Right" Classes="primary" Content="Apply"
                          Click="PortraitApply_Click"/>
                  <TextBlock x:Name="PortraitModelStatusText" Classes="muted" Text="" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Resting traits" Classes="section"/>
                <ItemsControl x:Name="PortraitTraitList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="110,*,40" Margin="0,3">
                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Column="1" Classes="gauge" Value="{Binding Weight}" Margin="6,0"
                                     VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Percent}" FontSize="10" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="PortraitTraitsEmptyText" Classes="muted" Text="" IsVisible="False"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- Bottom chrome: Victoria (left) · Call (center) · Settings (right) -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,*" Margin="16,2,16,14">
          <Button x:Name="VictoriaButton" Grid.Column="0" Classes="round" Width="46" Height="46"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Victoria_Click"
                  ToolTip.Tip="Victoria">
            <!-- PROP-22 v3: sculpted 3D V mark (not the word, not a person icon). -->
            <TextBlock Text="V" FontSize="22" FontWeight="Black" FontFamily="{DynamicResource DisplayFont}"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,-2,0,0">
              <TextBlock.Effect>
                <DropShadowEffect BlurRadius="0" OffsetX="0" OffsetY="1.5" Color="#AA000000" Opacity="0.85"/>
              </TextBlock.Effect>
            </TextBlock>
          </Button>
          <Button x:Name="CallButton" Grid.Column="1" Classes="round call" Click="CallToggle_Click"
                  ToolTip.Tip="Call — Soniox realtime voice">
            <Path Width="28" Height="28" Stretch="Uniform" Data="{StaticResource IconPhone}"
                  Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
          <Button x:Name="SettingsButton" Grid.Column="2" Classes="round" Width="46" Height="46"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Settings_Click"
                  ToolTip.Tip="Settings">
            <Path Width="22" Height="22" Stretch="Uniform" Data="{StaticResource IconGear}"
                  Fill="{Binding $parent[Button].Foreground}"/>
          </Button>
        </Grid>
      </Grid>

      <!-- VM drawer tab on the left or right edge (side set in code from VmDrawerSide). -->
      <Button x:Name="VmDrawerTab" Classes="vm-tab" HorizontalAlignment="Right" VerticalAlignment="Center"
              Margin="0,0,5,0" ZIndex="25" Click="VmDrawerTab_Click" ToolTip.Tip="Her screen (VM)">
        <Path x:Name="VmDrawerTabIcon" Width="10" Height="14" Stretch="Uniform"
              Data="{StaticResource IconChevronLeft}" Fill="{Binding $parent[Button].Foreground}"/>
      </Button>

      <Border Classes="shell-rim" Margin="0"/>

      <!-- PROP-12.1: frameless edge/corner resize (BeginResizeDrag). Z-order above content. -->
      <Border x:Name="ResizeWest" Width="5" HorizontalAlignment="Left" Margin="0,40" Background="Transparent"
              Cursor="SizeWestEast" PointerPressed="ResizeEdge_PointerPressed" Tag="West"/>
      <Border x:Name="ResizeEast" Width="5" HorizontalAlignment="Right" Margin="0,40" Background="Transparent"
              Cursor="SizeWestEast" PointerPressed="ResizeEdge_PointerPressed" Tag="East"/>
      <Border x:Name="ResizeNorth" Height="5" VerticalAlignment="Top" Margin="40,0" Background="Transparent"
              Cursor="SizeNorthSouth" PointerPressed="ResizeEdge_PointerPressed" Tag="North"/>
      <Border x:Name="ResizeSouth" Height="5" VerticalAlignment="Bottom" Margin="40,0" Background="Transparent"
              Cursor="SizeNorthSouth" PointerPressed="ResizeEdge_PointerPressed" Tag="South"/>
      <Border x:Name="ResizeNorthWest" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent" Cursor="TopLeftCorner" PointerPressed="ResizeEdge_PointerPressed" Tag="NorthWest"/>
      <Border x:Name="ResizeNorthEast" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="Transparent" Cursor="TopRightCorner" PointerPressed="ResizeEdge_PointerPressed" Tag="NorthEast"/>
      <Border x:Name="ResizeSouthWest" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomLeftCorner" PointerPressed="ResizeEdge_PointerPressed" Tag="SouthWest"/>
      <Border x:Name="ResizeSouthEast" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizeEdge_PointerPressed" Tag="SouthEast"/>
    </Grid>
  </Border>
  </Border>
</Window>
