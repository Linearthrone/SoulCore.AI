<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="House.ChatDesktop.MainWindow"
        Title="House Victoria — Presence"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="820"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- Top bar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="House Victoria"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}"
                     Margin="0,0,18,0"
                     VerticalAlignment="Center"/>
          <RadioButton x:Name="NavPresence"
                       Classes="nav"
                       GroupName="Nav"
                       Content="Presence"
                       IsChecked="True"
                       IsCheckedChanged="Nav_Changed"/>
          <RadioButton x:Name="NavSettings"
                       Classes="nav"
                       GroupName="Nav"
                       Content="Settings"
                       IsCheckedChanged="Nav_Changed"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{DynamicResource BadBrush}" Margin="0,0,8,0"/>
          <TextBlock x:Name="ConnStatusText"
                     Text="Connecting…"
                     Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center"
                     FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Presence -->
    <Grid x:Name="PresenceView" Margin="16"
          RowDefinitions="Auto,Auto,Auto,*,Auto">

      <!-- Alive / warm -->
      <Border Grid.Row="0"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="14,10"
              Margin="0,0,0,10">
        <Grid ColumnDefinitions="*,*,*,Auto">
          <StackPanel>
            <TextBlock Text="ALIVE" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="AliveText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="WARM" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="WarmText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="ENDPOINT" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock x:Name="EndpointText" Text="127.0.0.1:7700" FontSize="14" Margin="0,2,0,0"/>
          </StackPanel>
          <Button Grid.Column="3"
                  Classes="ghost"
                  Content="Refresh"
                  Click="Refresh_Click"
                  VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Emotion strip (WS emotion.snapshot) + inline correction panel -->
      <StackPanel Grid.Row="1" Margin="0,0,0,10">
        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="Emotion"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="EmotionLabelText" Text="—" Margin="0,0,16,0"/>
              <TextBlock Text="valence" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="ValenceText" Text="0.0" Margin="0,0,14,0"/>
              <TextBlock Text="arousal" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="ArousalText" Text="0.0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="via WS"
                         Foreground="{DynamicResource MutedBrush}"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>
              <Button x:Name="CorrectEmotionButton"
                      Classes="ghost"
                      Content="Correct…"
                      Click="CorrectEmotion_Click"
                      ToolTip.Tip="That wasn’t how I felt — send emotion.correct"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Correction panel (collapsed until Correct…) -->
        <Border x:Name="EmotionCorrectPanel"
                IsVisible="False"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,12"
                Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="Correct emotion"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Optional sliders + short note. Saves as WS emotion.correct; SoulCore persists and echoes emotion.snapshot."
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,8"
                  ColumnDefinitions="90,*,48"
                  RowDefinitions="Auto,Auto,Auto,Auto">

              <TextBlock Text="valence" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectValenceSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0"
                      TickFrequency="0.1" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center" Margin="0,4"/>
              <TextBlock Grid.Column="2" Text="{Binding #CorrectValenceSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>

              <TextBlock Grid.Row="1" Text="arousal" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectArousalSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                      TickFrequency="0.1" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center" Margin="0,4"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding #CorrectArousalSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>

              <TextBlock Grid.Row="2" Text="dominance" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectDominanceSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                      TickFrequency="0.1" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center" Margin="0,4"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding #CorrectDominanceSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>

              <TextBlock Grid.Row="3" Text="focus" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectFocusSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                      TickFrequency="0.1" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center" Margin="0,4"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding #CorrectFocusSlider.Value, StringFormat='{}{0:0.0}'}"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="Short note" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,4"/>
            <TextBox x:Name="CorrectNoteBox"
                     Classes="input"
                     AcceptsReturn="False"
                     MaxLength="200"
                     Height="36"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Classes="ghost"
                      Content="Cancel"
                      Margin="0,0,8,0"
                      Click="CorrectEmotionCancel_Click"/>
              <Button Classes="primary"
                      Content="Save correction"
                      Click="CorrectEmotionSave_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- SoulLoop want (WS loop.want) -->
      <Border Grid.Row="2"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="14,10"
              Margin="0,0,0,10">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="Want"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"/>
          <TextBlock x:Name="WantStatusText"
                     Grid.Column="1"
                     Text="(waiting for loop.want — SoulLoop may be off)"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}"/>
          <TextBlock Grid.Column="2"
                     Text="via WS"
                     Foreground="{DynamicResource MutedBrush}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0"/>
        </Grid>
      </Border>

      <!-- Transcript -->
      <Border Grid.Row="3"
              Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8">
        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="TranscriptList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="bubble" Classes.user="{Binding IsUser}">
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayRole}"
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Input -->
      <DockPanel Grid.Row="4" Margin="0,10,0,0">
        <Button DockPanel.Dock="Right"
                Classes="primary"
                Content="Send"
                Width="96"
                Margin="10,0,0,0"
                Click="Send_Click"/>
        <TextBox x:Name="ChatInput"
                 Classes="input"
                 AcceptsReturn="False"
                 Height="40"
                 VerticalContentAlignment="Center"
                 Padding="10,0"
                 KeyDown="ChatInput_KeyDown"/>
      </DockPanel>
    </Grid>

    <!-- Settings -->
    <Grid x:Name="SettingsView" Margin="16" IsVisible="False">
      <Border Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8">
        <TabControl Background="Transparent" BorderThickness="0">

          <TabItem Header="Identity">
            <StackPanel Margin="12">
              <TextBlock Text="Identity" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Shell-local display name for House Victoria. Charter / persona anchors still live in SoulCore — this tab does not rewrite Host settings."
                         Margin="0,0,0,16"/>
              <TextBlock Text="Display name" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Classes="ghost"
                        Content="Save"
                        Margin="8,0,0,0"
                        Click="IdentitySave_Click"/>
                <TextBox x:Name="DisplayNameBox"
                         Classes="input"
                         MaxLength="64"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         LostFocus="DisplayNameBox_LostFocus"/>
              </DockPanel>
              <TextBlock Text="Continuity" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBlock TextWrapping="Wrap"
                         Margin="0,0,0,16"
                         Text="Session continuity (alive / warm / emotion / want) is on Presence via Host WS. Episodic continuity stays in SoulCore memory — open the Memory tab for store path/open from /health."/>
              <TextBlock Text="Live presence" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <Button Classes="ghost"
                      Content="Open Presence →"
                      HorizontalAlignment="Left"
                      Click="OpenPresenceFromIdentity_Click"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Memory">
            <StackPanel Margin="12">
              <TextBlock Text="Memory" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Read-only view of SoulCore’s memory store from GET /health. Episodic rows live in SoulCore SQLite — this shell only shows path and open state, not episode contents."
                         Margin="0,0,0,16"/>
              <TextBlock Text="Path (memory.path)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="MemoryPathBox" Classes="input" IsReadOnly="True" Text="(probe /health)"
                       TextWrapping="Wrap"
                       Padding="8" Margin="0,0,0,12"/>
              <TextBlock Text="Open (memory.open)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="MemoryOpenBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,16"/>
              <TextBlock Text="Note"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,0,4"/>
              <TextBlock TextWrapping="Wrap"
                         Text="Episodic and emotion state are authored and recalled inside SoulCore. House displays store health only; use Presence for live emotion / want."/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Emotion">
            <StackPanel Margin="12">
              <TextBlock Text="Emotion" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Live values come from WS emotion.snapshot on the Presence strip. To correct (“that wasn’t how I felt”), use Correct… on Presence — optional sliders + short note send emotion.correct; SoulCore persists the correction and echoes an updated snapshot."
                         Margin="0,0,0,16"/>
              <TextBlock Text="Where to correct"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,0,4"/>
              <TextBlock Text="Presence → Emotion strip → Correct…"
                         Margin="0,0,0,12"/>
              <TextBlock Text="Frame"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="0,0,0,4"/>
              <TextBox Classes="input" IsReadOnly="True"
                       Text="emotion.correct { valence, arousal, dominance, focus, note }"
                       Padding="8"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Unreal">
            <StackPanel Margin="12">
              <TextBlock Text="Unreal bridge" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Host-side Unreal bridge status from GET /health → unreal. Desktop still talks only to SoulCore :7700 (HTTP health + WS). Refresh follows the existing 5s health poll."
                         Margin="0,0,0,16"/>
              <TextBlock Text="enabled" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="UnrealEnabledBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,12"/>
              <TextBlock Text="target" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="UnrealTargetBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,12"/>
              <TextBlock Text="connected" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="UnrealConnectedBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Safety/Charter">
            <StackPanel Margin="12">
              <TextBlock Text="Safety / Charter" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Charter anchors (persona, safety envelope, spend limits) live in SoulCore — this tab shows lock/drift/spend status from GET /health where available. The shell never rewrites charter anchors."
                         Margin="0,0,0,16"/>

              <TextBlock Text="Charter lock" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="CharterLockBox" Classes="input" IsReadOnly="True" Text="(probe /health)"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Drift report" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="CharterDriftBox" Classes="input" IsReadOnly="True" Text="none"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Spend meter" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="CharterSpendBox" Classes="input" IsReadOnly="True" Text="$0 / $30"
                       Padding="8" Margin="0,0,0,16"/>

              <Button Classes="ghost"
                      Content="View Charter Anchors"
                      HorizontalAlignment="Left"
                      Click="ViewCharterAnchors_Click"/>
              <Border x:Name="CharterAnchorsPanel"
                      IsVisible="False"
                      Background="{DynamicResource InputBrush}"
                      BorderBrush="{DynamicResource PanelBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10"
                      Margin="0,12,0,0">
                <TextBlock x:Name="CharterAnchorsText"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Charter anchors are managed inside SoulCore (persona YAML + safety envelope). Future: read live anchors from a SoulCore charter API endpoint."/>
              </Border>
            </StackPanel>
          </TabItem>

          <TabItem Header="System">
            <StackPanel Margin="12">
              <TextBlock Text="System" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Read-only Host endpoint and subsystem status from GET /health. Secrets stay in SoulCore .env — this tab shows non-secret config knobs only."
                         Margin="0,0,0,16"/>

              <TextBlock Text="Host endpoint" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemEndpointBox" Classes="input" IsReadOnly="True" Text="127.0.0.1:7700"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Bind address" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemBindBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Port" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemPortBox" Classes="input" IsReadOnly="True" Text="7700"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Inference provider (Ollama)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemInferenceBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Hermes status" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemHermesBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Memory DB path" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemMemoryPathBox" Classes="input" IsReadOnly="True" Text="—"
                       TextWrapping="Wrap"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Memory open" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemMemoryOpenBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="SoulLoop enabled" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemSoulLoopBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Unreal bridge target" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemUnrealTargetBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Unreal connected" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemUnrealConnectedBox" Classes="input" IsReadOnly="True" Text="—"
                       Padding="8" Margin="0,0,0,16"/>

              <Button Classes="ghost"
                      Content="Refresh"
                      HorizontalAlignment="Left"
                      Click="RefreshSystem_Click"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Voice/Video">
            <StackPanel Margin="12">
              <TextBlock Text="Voice / Video" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Future STT + Chatterbox (TTS) integration. Full-duplex audio is on the V1 path; WebRTC video is V1.1."
                         Margin="0,0,0,16"/>

              <TextBlock Text="Voice" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox Classes="input" IsReadOnly="True" Text="Not configured (V1.1 target)"
                       Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Video (WebRTC)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox Classes="input" IsReadOnly="True" Text="Deferred to V1.1 parallel spike"
                       Padding="8" Margin="0,0,0,16"/>

              <Button Classes="ghost"
                      Content="Configure Voice"
                      IsEnabled="False"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,12"/>

              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         FontSize="11"
                         Text="Full-duplex audio is on the V1 path; WebRTC video is V1.1."/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Notifications">
            <StackPanel Margin="12">
              <TextBlock Text="Notifications" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Play a sound when Victoria sends you a message while the window is unfocused or minimised. Default is the OS beep; you can pick your own .wav file below."
                         Margin="0,0,0,16"/>

              <CheckBox x:Name="NotifEnabledCheckBox"
                        Content="Enable notification sound"
                        IsChecked="True"
                        Margin="0,0,0,12"
                        Click="NotifEnabled_Click"/>

              <TextBlock Text="Sound file (.wav)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Classes="ghost"
                        Content="Browse…"
                        Margin="8,0,0,0"
                        Click="NotifBrowse_Click"/>
                <Button DockPanel.Dock="Right"
                        Classes="ghost"
                        Content="Clear"
                        Margin="8,0,0,0"
                        Click="NotifClear_Click"/>
                <TextBox x:Name="NotifSoundPathBox"
                         Classes="input"
                         IsReadOnly="True"
                         Text="(system beep)"
                         Watermark="(system beep — no custom file)"
                         Padding="8,0"/>
              </DockPanel>

              <TextBlock TextWrapping="Wrap"
                         Foreground="{DynamicResource MutedBrush}"
                         FontSize="11"
                         Text="Tip: pick any .wav file on your machine. When cleared, the OS default beep is used."
                         Margin="0,0,0,12"/>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Classes="primary"
                        Content="Test sound"
                        Click="NotifTest_Click"
                        Margin="0,0,8,0"/>
                <TextBlock x:Name="NotifStatusText"
                           Text=""
                           Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
