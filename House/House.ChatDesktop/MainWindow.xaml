<Window x:Class="House.ChatDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="House Victoria — Presence"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="820"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- Top bar -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="House Victoria"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource AccentBrush}"
                     Margin="0,0,18,0"
                     VerticalAlignment="Center"/>
          <RadioButton x:Name="NavPresence"
                       Style="{StaticResource NavButton}"
                       Content="Presence"
                       IsChecked="True"
                       Checked="NavPresence_Checked"/>
          <RadioButton x:Name="NavSettings"
                       Style="{StaticResource NavButton}"
                       Content="Settings"
                       Checked="NavSettings_Checked"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="{StaticResource BadBrush}" Margin="0,0,8,0"/>
          <TextBlock x:Name="ConnStatusText"
                     Text="Connecting…"
                     Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center"
                     FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Presence -->
    <Grid x:Name="PresenceView" Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Alive / warm -->
      <Border Grid.Row="0"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="14,10"
              Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="ALIVE" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="AliveText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="WARM" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="WarmText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="ENDPOINT" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="EndpointText" Text="127.0.0.1:7700" FontSize="14" Margin="0,2,0,0"/>
          </StackPanel>
          <Button Grid.Column="3"
                  Style="{StaticResource GhostButton}"
                  Content="Refresh"
                  Click="Refresh_Click"
                  VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- Emotion strip (WS emotion.snapshot) + inline correction panel -->
      <StackPanel Grid.Row="1" Margin="0,0,0,10">
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Emotion"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="EmotionLabelText" Text="—" Margin="0,0,16,0"/>
              <TextBlock Text="valence" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="ValenceText" Text="0.0" Margin="0,0,14,0"/>
              <TextBlock Text="arousal" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="ArousalText" Text="0.0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="via WS"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0"/>
              <Button x:Name="CorrectEmotionButton"
                      Style="{StaticResource GhostButton}"
                      Content="Correct…"
                      Click="CorrectEmotion_Click"
                      ToolTip="That wasn’t how I felt — send emotion.correct"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Correction panel (collapsed until Correct…) — no overlay tray -->
        <Border x:Name="EmotionCorrectPanel"
                Visibility="Collapsed"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,12"
                Margin="0,8,0,0">
          <StackPanel>
            <TextBlock Text="Correct emotion"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Optional sliders + short note. Saves as WS emotion.correct; SoulCore persists and echoes emotion.snapshot."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="48"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Text="valence" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectValenceSlider" Grid.Column="1" Minimum="-1" Maximum="1" Value="0"
                      TickFrequency="0.1" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center" Margin="0,4"
                      ValueChanged="CorrectSlider_ValueChanged"/>
              <TextBlock x:Name="CorrectValenceValue" Grid.Column="2" Text="0.0"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>

              <TextBlock Grid.Row="1" Text="arousal" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectArousalSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                      TickFrequency="0.1" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center" Margin="0,4"
                      ValueChanged="CorrectSlider_ValueChanged"/>
              <TextBlock x:Name="CorrectArousalValue" Grid.Row="1" Grid.Column="2" Text="0.0"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>

              <TextBlock Grid.Row="2" Text="dominance" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectDominanceSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                      TickFrequency="0.1" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center" Margin="0,4"
                      ValueChanged="CorrectSlider_ValueChanged"/>
              <TextBlock x:Name="CorrectDominanceValue" Grid.Row="2" Grid.Column="2" Text="0.5"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>

              <TextBlock Grid.Row="3" Text="focus" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              <Slider x:Name="CorrectFocusSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                      TickFrequency="0.1" IsSnapToTickEnabled="False"
                      VerticalAlignment="Center" Margin="0,4"
                      ValueChanged="CorrectSlider_ValueChanged"/>
              <TextBlock x:Name="CorrectFocusValue" Grid.Row="3" Grid.Column="2" Text="0.5"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="Short note" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
            <TextBox x:Name="CorrectNoteBox"
                     AcceptsReturn="False"
                     MaxLength="200"
                     Height="36"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     Background="#161A1F"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource GhostButton}"
                      Content="Cancel"
                      Margin="0,0,8,0"
                      Click="CorrectEmotionCancel_Click"/>
              <Button Style="{StaticResource PrimaryButton}"
                      Content="Save correction"
                      Click="CorrectEmotionSave_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- SoulLoop want (WS loop.want) — harmless while SoulLoop disabled -->
      <Border Grid.Row="2"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="14,10"
              Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Want"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"/>
          <TextBlock x:Name="WantStatusText"
                     Grid.Column="1"
                     Text="(waiting for loop.want — SoulLoop may be off)"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"/>
          <TextBlock Grid.Column="2"
                     Text="via WS"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0"/>
        </Grid>
      </Border>

      <!-- Transcript -->
      <Border Grid.Row="3"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8">
        <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="TranscriptList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="6"
                        Padding="12,8"
                        CornerRadius="6">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{StaticResource AssistantBubbleBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Role}" Value="user">
                          <Setter Property="Background" Value="{StaticResource UserBubbleBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayRole}"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Input -->
      <DockPanel Grid.Row="4" Margin="0,10,0,0">
        <Button DockPanel.Dock="Right"
                Style="{StaticResource PrimaryButton}"
                Content="Send"
                Width="96"
                Margin="10,0,0,0"
                Click="Send_Click"/>
        <TextBox x:Name="ChatInput"
                 AcceptsReturn="False"
                 Height="40"
                 VerticalContentAlignment="Center"
                 Padding="10,0"
                 Background="#161A1F"
                 Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 CaretBrush="{StaticResource TextBrush}"
                 KeyDown="ChatInput_KeyDown"/>
      </DockPanel>
    </Grid>

    <!-- Settings -->
    <Grid x:Name="SettingsView" Margin="16" Visibility="Collapsed">
      <Border Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8">
        <TabControl Background="Transparent" BorderThickness="0">
          <TabControl.Resources>
            <Style TargetType="TabItem">
              <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
              <Setter Property="Padding" Value="14,8"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBd" Padding="{TemplateBinding Padding}" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,8,0">
                      <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="TabBd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TabControl.Resources>

          <TabItem Header="Identity">
            <StackPanel Margin="12">
              <TextBlock Text="Identity" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         Text="Shell-local display name for House Victoria. Charter / persona anchors still live in SoulCore — this tab does not rewrite Host settings."
                         Margin="0,0,0,16"/>
              <TextBlock Text="Display name" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource GhostButton}"
                        Content="Save"
                        Margin="8,0,0,0"
                        Click="IdentitySave_Click"/>
                <TextBox x:Name="DisplayNameBox"
                         MaxLength="64"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Background="#161A1F" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" Padding="8,0"
                         LostFocus="DisplayNameBox_LostFocus"/>
              </DockPanel>
              <TextBlock Text="Continuity" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBlock TextWrapping="Wrap"
                         Margin="0,0,0,16"
                         Text="Session continuity (alive / warm / emotion / want) is on Presence via Host WS. Episodic continuity stays in SoulCore memory — open the Memory tab for store path/open from /health."/>
              <TextBlock Text="Live presence" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <Button Style="{StaticResource GhostButton}"
                      Content="Open Presence →"
                      HorizontalAlignment="Left"
                      Click="OpenPresenceFromIdentity_Click"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Memory">
            <StackPanel Margin="12">
              <TextBlock Text="Memory" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         Text="Read-only view of SoulCore’s memory store from GET /health. Episodic rows live in SoulCore SQLite — this shell only shows path and open state, not episode contents."
                         Margin="0,0,0,16"/>
              <TextBlock Text="Path (memory.path)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="MemoryPathBox" IsReadOnly="True" Text="(probe /health)"
                       TextWrapping="Wrap"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>
              <TextBlock Text="Open (memory.open)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="MemoryOpenBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,16"/>
              <TextBlock Text="Note"
                         Foreground="{StaticResource MutedBrush}"
                         Margin="0,0,0,4"/>
              <TextBlock TextWrapping="Wrap"
                         Text="Episodic and emotion state are authored and recalled inside SoulCore. House displays store health only; use Presence for live emotion / want."/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Emotion">
            <StackPanel Margin="12">
              <TextBlock Text="Emotion" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         Text="Live values come from WS emotion.snapshot on the Presence strip. To correct (“that wasn’t how I felt”), use Correct… on Presence — optional sliders + short note send emotion.correct; SoulCore persists the correction and echoes an updated snapshot."
                         Margin="0,0,0,16"/>
              <TextBlock Text="Where to correct"
                         Foreground="{StaticResource MutedBrush}"
                         Margin="0,0,0,4"/>
              <TextBlock Text="Presence → Emotion strip → Correct…"
                         Margin="0,0,0,12"/>
              <TextBlock Text="Frame"
                         Foreground="{StaticResource MutedBrush}"
                         Margin="0,0,0,4"/>
              <TextBox IsReadOnly="True"
                       Text="emotion.correct { valence, arousal, dominance, focus, note }"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Unreal">
            <StackPanel Margin="12">
              <TextBlock Text="Unreal bridge" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         Text="Host-side Unreal bridge status from GET /health → unreal. Desktop still talks only to SoulCore :7700 (HTTP health + WS). Refresh follows the existing 5s health poll."
                         Margin="0,0,0,16"/>
              <TextBlock Text="enabled" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="UnrealEnabledBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>
              <TextBlock Text="target" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="UnrealTargetBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>
              <TextBlock Text="connected" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="UnrealConnectedBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Safety/Charter">
            <StackPanel Margin="12">
              <TextBlock Text="Safety / Charter" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         Text="Charter anchors (persona, safety envelope, spend limits) live in SoulCore — this tab shows lock/drift/spend status from GET /health where available. The shell never rewrites charter anchors."
                         Margin="0,0,0,16"/>

              <TextBlock Text="Charter lock" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="CharterLockBox" IsReadOnly="True" Text="(probe /health)"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Drift report" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="CharterDriftBox" IsReadOnly="True" Text="none"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Spend meter" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="CharterSpendBox" IsReadOnly="True" Text="$0 / $30"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,16"/>

              <Button Style="{StaticResource GhostButton}"
                      Content="View Charter Anchors"
                      HorizontalAlignment="Left"
                      Click="ViewCharterAnchors_Click"/>
              <Border x:Name="CharterAnchorsPanel"
                      Visibility="Collapsed"
                      Background="#161A1F"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10"
                      Margin="0,12,0,0">
                <TextBlock x:Name="CharterAnchorsText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Charter anchors are managed inside SoulCore (persona YAML + safety envelope). Future: read live anchors from a SoulCore charter API endpoint."/>
              </Border>
            </StackPanel>
          </TabItem>

          <TabItem Header="System">
            <StackPanel Margin="12">
              <TextBlock Text="System" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         Text="Read-only Host endpoint and subsystem status from GET /health. Secrets stay in SoulCore .env — this tab shows non-secret config knobs only."
                         Margin="0,0,0,16"/>

              <TextBlock Text="Host endpoint" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemEndpointBox" IsReadOnly="True" Text="127.0.0.1:7700"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Bind address" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemBindBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Port" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemPortBox" IsReadOnly="True" Text="7700"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Inference provider (Ollama)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemInferenceBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Hermes status" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemHermesBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Memory DB path" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemMemoryPathBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Memory open" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemMemoryOpenBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="SoulLoop enabled" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemSoulLoopBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Unreal bridge target" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemUnrealTargetBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Unreal connected" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox x:Name="SystemUnrealConnectedBox" IsReadOnly="True" Text="—"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,16"/>

              <Button Style="{StaticResource GhostButton}"
                      Content="Refresh"
                      HorizontalAlignment="Left"
                      Click="RefreshSystem_Click"/>
            </StackPanel>
          </TabItem>

          <TabItem Header="Voice/Video">
            <StackPanel Margin="12">
              <TextBlock Text="Voice / Video" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap"
                         Foreground="{StaticResource MutedBrush}"
                         Text="Future STT + Chatterbox (TTS) integration. Full-duplex audio is on the V1 path; WebRTC video is V1.1."
                         Margin="0,0,0,16"/>

              <TextBlock Text="Voice" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox IsReadOnly="True" Text="Not configured (V1.1 target)"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,12"/>

              <TextBlock Text="Video (WebRTC)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
              <TextBox IsReadOnly="True" Text="Deferred to V1.1 parallel spike"
                       Background="#161A1F" Foreground="{StaticResource TextBrush}"
                       BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,0,0,16"/>

              <Button Style="{StaticResource GhostButton}"
                      Content="Configure Voice"
                      IsEnabled="False"
