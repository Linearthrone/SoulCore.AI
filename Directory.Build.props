<Project>
  <PropertyGroup>
    <!-- One product version for Presence, Host, and the class libraries they ship. -->
    <Version>1.1.4</Version>
    <InformationalVersion>1.1.4</InformationalVersion>
  </PropertyGroup>

  <!-- SixLabors.ImageSharp 3.2+ requires a license for Release (Debug warns only).
       Map env / gitignored file → MSBuild; never commit keys or *.lic contents.
       Env: SixLaborsLicenseKey (native) or SIXLABORS_LICENSE_KEY.
       File: repo-root or SoulCore/sixlabors.lic (gitignored). -->
  <PropertyGroup>
    <SixLaborsLicenseKey Condition="'$(SixLaborsLicenseKey)' == '' and '$(SIXLABORS_LICENSE_KEY)' != ''">$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SixLaborsLicenseKey)' == '' and '$(SixLaborsLicenseFile)' == ''">
    <SixLaborsLicenseFile Condition="Exists('$(MSBuildThisFileDirectory)sixlabors.lic')">$(MSBuildThisFileDirectory)sixlabors.lic</SixLaborsLicenseFile>
    <SixLaborsLicenseFile Condition="'$(SixLaborsLicenseFile)' == '' and Exists('$(MSBuildThisFileDirectory)SoulCore\sixlabors.lic')">$(MSBuildThisFileDirectory)SoulCore\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <!-- run_test_sandbox sets these so a fix compiles away from the host bin,
       which stays locked while SoulCore.Host is running. Intermediate obj stays
       in the project so the SDK's default obj exclude still applies. -->
  <PropertyGroup Condition="'$(VictoriaToolSandbox)' == 'true' and '$(VictoriaToolSandboxRoot)' != ''">
    <BaseOutputPath>$(VictoriaToolSandboxRoot)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>
</Project>
